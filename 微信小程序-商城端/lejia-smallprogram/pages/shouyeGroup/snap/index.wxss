/* pages/shouyeGroup/snap/index.wxss */
#snap swiper {
  background-color: #fafafa;
  height: calc( 100vw * 0.4266 );
}

#snap swiper swiper-item image {
  width: 100%;
  height: 100%;
}
.top {
  z-index: 100;
  position: fixed;
  height: 550rpx;
  left: 0;
  right: 0;
  top: 0px;
}

.top-text {
  display: block;
  height: 72rpx;
  background-color: #fafafa;
  color: #5c5c5c;
  line-height: 72rpx;
  padding-left: 24rpx;
  font-size: 28rpx;
}

.time-list {
  display: flex;
  background-color: white;
}

.time-list .time-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
  line-height: 1.3;
  padding: 20rpx 0;
}

.time-list .time-item .time-date {
  font-size: 40rpx;
  color: #5c5c5c;
}

.time-list .time-item .time-state {
  font-size: 28rpx;
  color: #5c5c5c;
}

.time-item-selected {
  background-color: #f24539;
  position: relative;
}

.state-border {
  width: 0;
  height: 0;
  border: 10rpx solid;
  border-color: #f24539 transparent transparent;
  position: absolute;
  bottom: -18rpx;
}

.time-list .time-item-selected .time-date,
.time-list .time-item-selected .time-state {
  color: #fff;
}

.main {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  top: 550rpx;
}

.item {
  display: flex;
  align-items: center;
  height: 200rpx;
}

.item-left {
  margin-left: 24rpx;
  padding-top: 10rpx;
  width: 180rpx;
  height: 180rpx;
  position: relative;
}

.icon-image {
  position: absolute !important;
  top: 30rpx;
  left: 30rpx;
}

.item-right {
  height: 100%;
  padding-left: 24rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-bottom: 2rpx solid #d9d9d9;
}

.item-right-title {
  padding-top: 12rpx;
  padding-right: 12rpx;
  width: 460rpx;
  color: #5c5c5c;
  font-size: 32rpx;
}

.progress {
  width: 45%;
  height: 28rpx;
  border-radius: 24rpx;
  background-color: rgba(225, 83, 67, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal !important;
}

.progress-curre {
  border-radius: 24rpx;
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(225, 83, 67, 1);
  width: 35%;
}

.progress-num {
  z-index: 100;
  flex: 1;
  text-align: center;
  color: white;
  font-size: 24rpx;
  height: 28rpx;
  line-height: 28rpx;
}

.item-right-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.num-curre {
  color: #f24539;
  font-size: 42rpx;
  margin-right: 24rpx;
}

.num-ori {
  font-size: 28rpx;
  color: #5c5c5c;
  flex: 1;
  text-decoration: line-through;
}

.buy-btn {
  height: 60rpx !important;
  width: 100%;
  margin-bottom: 24rpx;
  border-radius: 12rpx !important;
}