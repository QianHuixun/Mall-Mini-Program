/* pages/shouyeGroup/poverty/index.wxss */
page {
  background-color: #f5f5f5;
}

#poverty-zone {
  background-color: #f5f5f5;
}

#poverty-zone swiper {
  background-color: #fafafa;
  height: 300rpx;
}

#poverty-zone swiper swiper-item image {
  width: 100%;
  height: 100%;
}

.seg-view {
  margin-top: 20rpx;
  background-color: white;
  height: 76rpx;
  display: flex;
  align-items: center;
}

.seg-view .seg {
  display: flex;
  height: 29rpx;
  /* background-color: #d7a73c; */
  margin: 28rpx;
  flex: 1;
  overflow: hidden;
}

.seg-view .seg .van-image {
  display: block;
}

.seg-view text {
  flex: 1;
  text-align: center;
  color: #5c5c5c;
  font-size: 28rpx;
}

.content {
  margin-top: 9rpx;
  background-color: #f5f5f5;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.item {
  width: 49%;
  height: 510rpx;
  background-color: white;
  margin-bottom: 24rpx;
  padding-bottom: 10rpx;
  text-align: center;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-top: 12rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.item-tag {
  position: absolute;
  top: 0;
  left: 0;
  padding: 6rpx;
  background-color: #3ccf8a;
  color: #f5f5f5;
  font-size: 24rpx;
  z-index: 100;
}

.item-title {
  color: #5c5c5c;
  font-size: 26rpx;
  margin: 0 12rpx;
  flex: 1;
  text-align: left;
}

.item-label {
  font-size: 30rpx;
  padding-left: 12rpx;
  text-align: left;
  text-decoration: line-through;
  color: #999;
  flex: 1;
}

.num-view {
  margin: 0 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
}

.tag {
  font-size: 28rpx;
  color: #f24539;
}

.price {
  font-size: 40rpx;
  color: #f24539;
  flex: 1;
  text-align: left;
}

.sale {
  font-size: 24rpx;
  color: #999999;
}