/* pages/shouyeGroup/position/index.wxss */

page {
  height: 100%;
}

#position {
  background-color: #fafafa;
  position: relative;
  height: 100%;
}


.top {
  background-color: white;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-left: 24rpx;
}

.are-text {
  color: #5c5c5c;
  margin: 12rpx;
  font-size: 28rpx;
}

.curr-adress {
  background-color: white;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.curr-adress-text-con {
  flex: 1;
  margin-left: 24rpx;
  font-size: 28rpx;
  height: 42rpx;
  line-height: 42rpx;
  overflow: hidden;
  white-space:nowrap; 
  text-overflow:ellipsis; 
}

.curr-adress-text-title {
  margin-right: 24rpx;
  font-size: 24rpx;
  color: #5c5c5c;
  height: 42rpx;
  line-height: 42rpx;
}

.curr-adress .van-icon {
  height: 42rpx;
  line-height: 42rpx;
}

.list-view {
  position: absolute;
  left: 0;
  top: 248rpx;
  right: 0;
  bottom: 0;
  background-color: white;
}

.item{
  position: relative;
  display: flex;
  align-items: center;
  padding: 12rpx;
  padding-left: 24rpx;
  line-height: 40rpx;
  border-bottom: 1px solid #fafafa;
  font-size: 24rpx;
  color: #999999;
}
.item .item-image {
  width: 168rpx;
  height: 168rpx;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  border-radius: 20rpx;
}
.item .item-image .van-image {
    width: 100%;
    height: 100%
}
.item .item-name {
    font-weight: 600;
    font-size: 28rpx;
    color: #333333;
}
.item .item-addr {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; /* 限制显示的行数为3行 */
  overflow: hidden;
}
.item .item-time {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.item .item-detail {
    display: flex;
    align-items: center;
    position: absolute;
    bottom: 10rpx;
    right: 20rpx;
}