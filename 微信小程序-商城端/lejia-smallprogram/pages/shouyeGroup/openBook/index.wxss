/* pages/shouyeGroup/openBook/index.wxss */
#openBook swiper {
  background-color: #fafafa;
  height: calc(100vw * 0.4266);
}

#openBook swiper swiper-item image {
  width: 100%;
  height: 100%;
}

page {
  background-color: #f5f5f5;
}

.top-image {
  display: block !important;
}

.active-tab {
  color: #f24539 !important;
}

.new-view {
  background-color: #f5f5f5;
}

.title {
  background-color: white;
  color: #ffc428;
  width: 100%;
  height: 85rpx;
  line-height: 85rpx;
  display: block;
  text-align: center;
  font-size: 33rpx;
}

.new-content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
}

.new-item {
  background-color: white;
  width: 44%;
  padding: 12rpx;
  margin-left: 1.7%;
  margin-top: 12rpx;
  text-align: center;
  border-radius: 16rpx;
  overflow: hidden;
}

.new-item-cutdown {
  text-align: left;
  padding-left: 5%;
}

.new-item-title {
  overflow: hidden;
  padding: 0 5% 6rpx 5%;
  /* white-space: nowrap; */
  text-overflow: ellipsis;
  line-height: 36rpx;
  height: 70rpx;
  text-align: left;
  color: #5c5c5c;
  font-size: 28rpx;

}

.van-count-down {
  width: 100%;
}

.time-top-item-text {
  margin-left: 6rpx;
  margin-right: 6rpx;
  font-size: 24rpx;
  color: #5c5c5c;
}

.time-top-item {
  background-color: #f24539;
  color: white;
  font-size: 24rpx;
  padding-left: 6rpx;
  padding-right: 6rpx;
}

.new-item-num {
  text-align: left;
  font-size: 24rpx;
  color: #f24539;
  display: block;
  margin-left: 5%;
  margin-top: 12rpx;
}

.price-view {
  margin-left: 5%;
  display: flex;
  color: #f24539;
  align-items: baseline;
  padding-bottom: 12rpx;
}

.price-view-title {
  font-size: 24rpx;
}

.price-view-num {
  font-size: 36rpx;
  font-weight: bold;
}

.will-item-time {
  font-size: 24rpx;
  color: #999999;
  text-align: left;
  display: block;
  margin-left: 5%;
  margin-top: 6rpx;
}

#openBook .van-tabs__line {
  height: 1px;
}

#openBook .van-image {
  width: 100%;
  height: calc(31vw - 24rpx);
}