<!--pages/shouyeGroup/shareZone/index.wxml-->
<view id="shareZone">
  <!-- <van-image width="100%" fit="widthFix" src="{{imgSrc}}" /> -->
  <swiper indicator-dots="true" circular="true" indicator-color="#fff" indicator-active-color="#4dce78" autoplay>
		<swiper-item wx:for="{{imageList}}" wx:key="pkey">
			<image src="{{item.photo}}" data-urltype="{{item.urlType}}" data-url="{{item.objKey}}" data-jump="{{item.jump}}"  bindtap="goAds"></image>
		</swiper-item>
	</swiper>
  <!-- <text class="title">分享商品，享佣金</text> -->
  <view class="item"  wx:for="{{goodsList}}" wx:key="index">
    <van-image style="margin: 0 30rpx;" width="240rpx" height="240rpx" src="{{item.wrapperPhoto ||'/images/no-pic.png'}}"  data-id='{{item}}' bindtap="goodsClick"/>
    <view class="item-right">
      <view style="width:90%" class="van-multi-ellipsis--l2"  data-id='{{item}}' bindtap="goodsClick">
        {{item.title}}
      </view>
      <view class="item-center"  data-id='{{item}}' bindtap="goodsClick">
        <text class="item-center-one">价值：</text>
        <text class="item-center-two">￥</text>
        <text class="item-center-three">{{item.price}}</text>
      </view>
      <view class="item-bottom">
        <!-- <image src="../../../images/shareBg.png" class="item-bottom-left">
          <text class="item-bottom-left-title">分享赚</text>
          <text class="item-bottom-left-num">{{item.comm}}元</text>
        </image> -->
        <view class="gray_clr">销量：<text>{{item.xsNum}}</text></view>
        <button color="#f24539" class="btn" open-type="share" data-title="{{item.title}}" data-pkey="{{ item.pkey }}" data-img="{{item.wrapperPhoto}}">
          分享赚 <text>{{item.comm}}</text>元
        </button>
        
      </view>
    </view>
  </view>
  <view style="text-align: center;margin: 24rpx;color:#5C5C5C;font-size:24rpx;" class="note_text">
    <view wx:if="{{loadingBom}}">加载中...</view>
    <view wx:if="{{noMoreBom}}">没有更多了</view>
  </view>
</view>