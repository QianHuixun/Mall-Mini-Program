/* pages/shouyeGroup/recipe/search.wxss */
.hot-view{
  padding: 24rpx;
  background-color: #FAFAFA;
  color: #5C5C5C;
}

.van-tag--large{
  margin: 24rpx 12rpx;
  margin-bottom: 0;
  padding: 24rpx 12rpx;
}

.sear-good-view{
  position: fixed;
  left: 0;
  top: 108rpx;
  right: 0;
  bottom: 0;
  background-color: white;
  overflow-y: auto;
}

.sear-good-view-topseg{
  width: 100%;
  height: 24rpx;
  background-color: #FAFAFA;
}

.good-view{
  margin: 24rpx;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #d9d9d9;
  padding: 12rpx;
}

.good-view .van-image__img{
  border-radius: 12rpx;
}

.good-view text{
  flex: 1;
  color: #5C5C5C;
  margin-left: 24rpx;
}