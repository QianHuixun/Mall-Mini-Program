  <view class="seg-view">
    	<view class="seg">
				<van-image src="/images/seg_green_left.png" width="216rpx" height="29rpx" />
			</view>
    <text>菜谱大全</text>
    	<view class="seg">
				<van-image src="/images/seg_green_right.png" width="216rpx" height="29rpx" />
			</view>
  </view>
  <view class="classify class-tab">
    <view class="class-tab-item {{ctype=='' ? 'active' : ''}}" data-pkey="" bindtap="handleTab">全部</view>
    <view class="class-tab-item {{ctype==item.pkey ? 'active' : ''}}" wx:key="index" wx:for="{{classList}}" data-pkey="{{item.pkey}}" bindtap="handleTab">{{item.name}}</view>
  </view>
  <view class="content">
    <view class="item" wx:for="{{caipuList}}" wx:key="index" bindtap="caipuClick" data-id='{{item}}'>
      <van-image src="{{item.wrapperPhoto}}"/>
      <view class="item-bottom">
        <text class="item-bottom-title">{{item.name}}</text>
        <view class="item-bottom-num">{{item.collCount}} <van-icon name="like" color="red" size="24rpx"/></view> 
      </view>
    </view>
  </view>
 <load-more id="loadMoreView" bindloadMoreListener='loadMoreListener' bindclickLoadMore='clickLoadMore'></load-more>
</view>