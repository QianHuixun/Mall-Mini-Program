<!--pages/shouyeGroup/recipe/index.wxml-->
<view id="recipe">
  <view class="top">
    <van-search disabled bindtap="searfocus" value="{{ value }}" shape="round" placeholder="豆腐" style="flex: 1;" />
    <view class="top-rig" bindtap="collectClick">
      <van-icon name="like" color="red" size="18px" />
      <text>收藏</text>
    </view>
  </view>
  <swiper indicator-dots="true" circular="true" indicator-color="#fff" indicator-active-color="#4dce78" autoplay>
		<swiper-item wx:for="{{imageList}}" wx:key="pkey">
			<image src="{{item.photo}} " data-urltype="{{item.urlType}}" data-url="{{item.objKey}}" data-jump="{{item.jump}}" bindtap="goAds"></image>
		</swiper-item>
	</swiper>
