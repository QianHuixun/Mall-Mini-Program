/* pages/shouyeGroup/recipe/collect.wxss */
page{
  height: 100%;  
}

#finishOrder{
  height: 100%;  
}
.scroll-view {
  width: 100%;
  height: 100%;
}
#collect-view .item{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border-bottom: 1px solid #d9d9d9;
}

.content{
  height: 110rpx;
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.lick-view{
  display: flex;
  align-items: center;
}

.num{
  color: #5C5C5C;
  margin-left: 12rpx;
  font-size: 28rpx;
}