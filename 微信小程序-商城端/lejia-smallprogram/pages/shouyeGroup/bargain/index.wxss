#bargain swiper {
  background-color: #fafafa;
  height: calc(100vw * 0.4266);
}

#bargain swiper swiper-item image {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 32rpx;
  color: #ffc428;
  display: block;
  text-align: center;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}

.item {
  margin-top: 24rpx;
  display: flex;
  height: 240rpx;
  align-items: flex-start;
}

.item-right {
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  border-bottom: 2rpx solid #d9d9d9;
  justify-content: space-between;
  font-size: 28rpx;
  margin-right: 15px;
}

.item-right .van-multi-ellipsis--l2 {
  margin: 17rpx 0 34rpx 0;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 38rpx;
  overflow: hidden;
}

.item-center {
  display: flex;
  align-items: baseline;
}

.item-center .label {
  display: inline-block;
  margin-right: 10rpx;
}

.item-center {
  /* text-decoration: line-through; */
  font-size: 26rpx;
  margin-bottom: 6rpx;
}

.item-center-one {
  font-size: 28rpx;
}

.price-box {
  color: #f24539;
  font-size: 28rpx;
}


.item-center-three {
  font-size: 40rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.item-bottom-left {
  width: 220rpx;
  height: 50rpx;
  position: relative;
}

.item-bottom-left-title {
  position: absolute;
  left: 12rpx;
  top: 7rpx;
  color: #ffc428;
  font-size: 24rpx;
}

.item-bottom-left-num {
  position: absolute;
  right: 12rpx;
  top: 7rpx;
  color: #5c5c5c;
  font-size: 24rpx;
}

