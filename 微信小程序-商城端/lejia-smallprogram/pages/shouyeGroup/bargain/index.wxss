.item-bottom .gray_clr {
  font-size: 28rpx;
}
.item-bottom .btn-box{
  display: flex;
  align-items: center;
}
.item-bottom .btn-box .btn {
  display: inline-block;
  color: #fff;
  margin-right: 10rpx;
  background: #f24539;
  border-color: #f24539;
  height: 30px;
  /* width: 140rpx; */
  
  font-size: 12px;
  border-radius: 999px;

}

.item-bottom .btn-box .van-btn {
  width: 140rpx;
}

#bargain .van-tag {
  position: relative;
  margin-left: 10rpx;
  top: -5rpx;
  background: #fff4e1;
  border-radius: 8rpx;
  border: 1px solid #fea372;
}

.popup-box {
  width: 300px;
  height: 320px;
  /* border-radius: 10rpx; */
  text-align: center;

}

.popup-box .img-box {
  width: 80%;
  height: 200px;
  margin: 0 auto;
}

.img-box image {
  width: 100%;
  height: 100%;
}

.popup-box .label {
  margin: 10rpx 0 40rpx 0;
  font-size: 36rpx;
  color: #f85036;
}

.popup-box .share-btn {
  width: 70%;
  color: white;
  background: linear-gradient(to bottom, rgb(251, 125, 38), rgb(237, 83, 52));
  border: 0;
  border-radius: 999px;
}

.van-popup .van-icon {
  color: #f85036;
}