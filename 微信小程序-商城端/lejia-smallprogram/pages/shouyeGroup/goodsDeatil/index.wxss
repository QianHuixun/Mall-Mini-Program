  padding: 8rpx 8rpx 24rpx 8rpx;
  box-sizing: border-box;
  background: #F7F7F7;
}

.process_item.checked {
  border: 1px solid #0DAE4E;
  background:  rgba(13,174,78,0.05);
}

.process_item_title {
  font-size: 26rpx;
  color: #333333;
  line-height: 30rpx;
  margin-bottom: 12rpx;
}
.process_item.checked .process_item_title  {
  color: #0DAE4E;
}
.process_item_price {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333333;
}

.process_item_price__left {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}
.process_item.checked .process_item_price__left  {
  color: #0DAE4E;
}

.process_item_price__right {
  width: 40rpx;
}

/* tabs 组件 图文详情、评价*/

.specificat-tabs {
  margin-top: 20rpx;
  background-color: white;
  /* margin-bottom: 56rpx; */
} 

.specificat-tabs-nav {
    width: 320rpx;
}

.specificat-tabs-tab {
  width: 160rpx;
  flex: none !important;
}

/* end tabs组件 图文详情、评价*/

/* 评论 */
.first-scroll {
  height: 700rpx;
  overflow:auto;
}
.look-evaluate {
  margin: 0 24rpx;
}
/* 评论区 */
.look-evaluate-main {
  margin-top: 20rpx;
}

/* 商品模块 */
.look-evaluate-item {
  background: #fff;
  padding : 24rpx;
  margin-bottom: 20rpx;
  width: 100vw;
  box-sizing: border-box;
  border-bottom:  1px solid #f6f6f6;
}

.look-evaluate-item_top {
 display: flex;
 align-items: center;
}

.look-evaluate-item_top .top-image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.look-evaluate-item_top__right {
  flex: 1;
  width: 0;
}

.look-evaluate-item_top__right___top {
  font-size: 28rpx;
  color: #333333;
}

.look-evaluate-item_top__right___bottom text {
  color: #666;
  font-size: 24rpx;
  margin-left: 16rpx;
}
/* end 商品模块 */
/* 评论文本 */
.look-evaluate_item__middle {
  margin-top: 16rpx;
  font-size: 28rpxpx;
  color: #333333;
}
/* end 评论文本 */

/* 图片上传 */
.look-evaluate_item__third .item-image {
  width: 98rpx;
  height: 98rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 12rpx;
  margin-top: 32rpx;
}

.look-evaluate_item__third van-image:last-child .item-image {
  margin-right: 0;
}
/* end 图片上传 */

/* 回复区 */
.look-evaluate_item__bottom {
  background: #F7F7F7;
  border-radius: 16rpx;
  padding: 16rpx;
  position: relative;
}

.look-evaluate_item__bottom.hidden  {
  height: 0;
  overflow: hidden;
  visibility: hidden;
  padding: 0;
}

.text-content {
  line-height: 40rpx; /* 需与JS中行高一致 */
  font-size: 28rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: #666;
}
.toggle-btn {
  color: #333; 
  font-size: 26rpx;
  position: absolute;
  right: 0;
  top: 56rpx;
  line-height: 40rpx;
  background-color: #F7F7F7;
  width: 4em;
}
.ellipsis { -webkit-line-clamp: 2; }  /* 默认显示2行 */
.unellipsis { -webkit-line-clamp: 0; } /* 0表示无行数限制 */
/* end 评论 */

.footer-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12rpx;
    background: #FFFFFF;
}