/* pages/shouyeGroup/goodsDeatil/index.wxss */

.main {
  overflow-y: auto;
  background-color: #f2f4f7;
}

#goodsDeatil {
    width: 100vw;
}

#goodsDeatil .lj-swipe {
  position: relative;
}

#goodsDeatil swiper {
  background-color: #f2f4f7;
  height: 100vw;
}

#goodsDeatil swiper swiper-item image {
  width: 100%;
  height: 100%;
}

.page-view {
  display: flex;
  align-items: center;
  position: absolute;
  height: 40rpx;
  right: 16rpx;
  bottom: 24rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  color: white;
  background: rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
}

.page-num,
.page-total-num {
  font-size: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
}


.detail-view {
  display: flex;
  flex-direction: column;
  padding: 32rpx 24rpx;
  background-color: white;
}

.detail-view-top,
.detail-view-name {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.top-small {
  color: #ED4528;
  font-size: 30rpx;
  font-weight: bold;
  padding-right: 8rpx;
}

.count-down-item.integral .top-small {
  font-size: 30rpx;
  line-height: 30rpx;
  font-weight: bold;
  color: #F1D09A;
}

.presale .top-small {
  color: #999;
}

.top-big {
  font-size: 56rpx;
  font-weight: bold;
  color: #ED4528;
  line-height: 56rpx;
}

.count-down-item.integral .top-big {
  font-size: 56rpx;
  font-weight: bold;
  color: #F1D09A;
}

.presale .top-big {
  color: #999;
}

.presale,
.groupon {
  display: flex;
  align-items: center;
}

.count-down-item {
  margin: 0 -24rpx;
  margin-top: -32rpx;
  position: relative;
  z-index: 1;
}

.count-down-item image {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 96rpx;
}

.count-down-item .count-down-item_detail {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  color: #FFFFFF;
}

.count-down-item .count-down-item_detail .end-time {
  font-size: 26rpx;
  line-height: 26rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.count-down-item .count-down-item_detail .end-time .time-tips {
  font-size: 22rpx;
  line-height: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.count-down-item .top-small {
  color: #FFFFFF;
}

.count-down-item .top-big {
  color: #FFFFFF;
}

.count-down-item .decoration-b,
.count-down-item .decoration {
  color: #FFFFFF;
}

.count-down-item.integral .decoration-b,
.count-down-item.integral .decoration {
  color: #D2B78A;
}

.count-down-item.integral .decoration-b {
  margin-left: 16rpx;
}

.count-down-item .sales-condition {
  padding: 24rpx 24rpx 0 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.count-down-item .sales-condition .tag-type {
  background: #FFF4F2;
  border: 2rpx solid #ED4528;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 20rpx;
  font-weight: 500;
  color: #ED4528;
  padding: 4rpx 8rpx;
}

.detail-view-name .top-small {
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.price-cell {
  flex: 1;
  display: flex;
  align-items: flex-end;
}

.price-cell image {
  width: 100%;
}

.price-cell .collage-price-box {
  margin-left: 24rpx;
}

.price-cell .collage-price-box .collage-price {
  background: #FFFFFF;
  border: 2rpx solid #FF3A3A;
  border-radius: 17rpx 13rpx 13rpx 0rpx;
  padding: 6rpx 12rpx;
  font-size: 20rpx;
  line-height: 20rpx;
  font-weight: bold;
  color: #ED4528;
}

.time-tips {
  text-align: center;
  font-size: 22rpx;
  line-height: 22rpx;
  margin-bottom: 10rpx;
  font-weight: 500;
  color: #FFF5EE;
}

.time-top-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #FFFFFF;
  width: 40rpx;
  height: 40rpx;
  background: #FB5B1C;
  border-radius: 6rpx;
}

.time-top-item-text {
  margin: 0 8rpx;
  height: 15px;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 500;
  color: #FFF5EE;
}

.time-top-item-text.day {
  margin-left: 0;
  margin-right: 16rpx;
  font-size: 26rpx;
  line-height: 40rpx;

}

.decoration-b {
  font-size: 28rpx;

  font-size: 24rpx;
  font-weight: 500;
  text-decoration: line-through;
  color: #999999;
}

.decoration {
  font-size: 24rpx;
  font-weight: 500;
  text-decoration: line-through;
  color: #999999;
  flex: 1;
  text-decoration: line-through;
}

.sales-condition {
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 500;
  color: #999999;
}

.sales-condition text+text {
  padding-left: 22rpx;
}

.detail-view-center {
  font-weight: bold;
  margin-top: 32rpx;
  font-size: 32rpx;
  color: #333333;
  line-height: 48rpx;
  padding: 7rpx 0;
}

.detail-view-center .tag {
  float: left;
  margin-right: 13rpx; 
  margin-top: 8rpx;
  white-space: nowrap;
  flex-shrink: 0; /* 禁止标签压缩 */
}

.detail-view-points {
  margin-top: 10rpx;
  background-color: RGBA(216, 216, 216, 0.41);
  border-radius: 10rpx;
  display: flex;
  padding: 18rpx 0;

}
.detail-view-points-item {
  box-sizing: border-box;
  flex:1;
  text-align: center;
  flex-shrink: 0; /* 禁止收缩 */
  padding: 0 20rpx;
  position: relative;
}
.text-ellipsis {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.detail-view-points-item+.detail-view-points-item::after {
  content: "";
  display: block;
  position: absolute;
  left: 0;
  top: 22rpx;
  background: #ccc;
  width: 1px;
  height: 48rpx;
  
}

.detail-view-points .detail-view-points-item_point {
  font-size: 28rpx;
  overflow: hidden;
}

.detail-view-points .detail-view-points-item_tips {
  font-size: 26rpx;
  color: #999999;
  min-width: 0; /* 允许收缩 */
}

.detail-view-bottom {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-end;
  color: #999;
  font-size: 26rpx;
  /* justify-content: space-between; */
}

.tag {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.tag text {
  margin-right: 10rpx;
}

.sales-num {
  /* width:  280rpx; */
  padding-left: 20rpx;
  text-align: right;
}

.specificatSelect {
  margin-top: 20rpx;
  background-color: white;
  padding: 32rpx 24rpx;
}

.specificatSelect .num_cell {
  display: flex;
  align-items: center;
  padding-bottom: 26rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}


.specificatSelect .num_cell:last-child {
  padding: 20rpx 0 0 0;
}

.specificatSelect .num_cell .title {
  flex: 1;
  padding: 10rpx 0;
}

.specificatSelect .space-tag {
  margin-right: -16rpx;
}

.specificatSelect .tag-space {
  box-sizing: border-box;
  display: inline-block;
  text-align: center;
  min-width: 162rpx;
  margin-bottom: 16rpx;
  margin-right: 16rpx;
  padding: 0 16rpx;
  background-color: #FFFFFF;
  font-size: 26rpx;
  line-height: 64rpx;
  font-weight: 500;
  color: #333333;
  border: 2rpx solid #F0F0F0;
  height: 64rpx;
  border-radius: 32rpx;
}

.specificatSelect .tag-space-active {
  background: rgba(13, 174, 78, 0.05);
  border-color: #0DAE4E;
  color: #0DAE4E;
}

.specificatSelect .tag-space-active.custom {
    background: rgba(9, 175, 132, 0.05);
    border-color: #09AF84;
    color: #09AF84;
  }

.specificatSelect .tag-space.noNum {
  background: #F0F0F0;
  color: #999999;
} 

.specificatSelect .space-stepper_minus {
  border-radius: 50%;
  background: #fff;
  border: 1px solid #999999;
}

.space-stepper .van-stepper__minus--disabled {
  border-color: #f5f5f5 !important;
  background-color: #f5f5f5 !important;
  color: #cccccc !important;
}

.specificatSelect .space-stepper_plus,
.specificatSelect .space-stepper_minus {
  width: 44rpx;
  height: 44rpx;
}

.specificatSelect .space-stepper_plus {
  border-radius: 50%;
  /* background: #4dce78;
  border: 1px solid #4dce78; */
  color: #fff;

}

.specificatSelect .space-stepper_minus {
  border-color: #4dce78;
  color: #4dce78;

}

.specificatSelect .space-stepper_input {
  background: #fff;
  color: #333333;
  height: 44rpx;
  width: 88rpx !important;
  line-height: 44rpx;
  padding: 0;
}

/** 商户START */
.merchant {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    padding: 16rpx;
    background: #FFFFFF;
}
.merchant-info {
    display: flex;
    align-items: center;
}
.merchant-head {
    width: 96rpx;
    height: 96rpx;
    margin-right: 16rpx;
    border-radius: 16rpx;
    background-color: #999999;
}
.merchant-head .van-image {
    width: 100%;
    height: 100%;
}
.merchant-booth {
    height: 90rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.merchant-booth-name {
    font-size: 15px;
    color: #333333;
}
.merchant-booth-num {
    font-size: 12px;
    color: #A56D41;
}
.merchant-sale {
    font-size: 15px;
    color: #333333;
}
/** 商户END */

/** 为你推荐START*/
.recommending-goods {
    width: 100%;
    overflow: hidden;
    margin-top: 20rpx;
    padding: 16rpx 24rpx;
    box-sizing: border-box;
    background: #FFFFFF;
}
.recommending-goods-title {
    font-weight: bold;
    font-size: 30rpx;
    color: #333333;
}
.recommending-goods-list {
    display: flex;
    overflow-x: scroll;
    overflow-y: hidden;
}
.recommending-goods .goods-list-item {
    position: relative;
    padding: 8rpx;
    background: #F7F7F7;
    border-radius: 16rpx;
}
.recommending-goods .goods-list-item + .goods-list-item {
    margin-left: 16rpx;
}
.recommending-goods .goods-list-item-image {
    width: 210rpx;
    height: 210rpx;
    background: #CCCCCC;
    border-radius: 16rpx;
}
.recommending-goods .goods-list-item-name {
    width: 210rpx;
    margin-top: 8rpx;
    height: 76rpx;
    line-height: 38rpx;
    font-weight: bold;
    font-size: 26rpx;
    color: #333333;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
}
.recommending-goods .goods-list-item-price {
    line-height: 40rpx;
    font-weight: bold;
    font-size: 28rpx;
    color: #ED4528;
    font-family: PingFang SC, PingFang SC;
}
.recommending-goods .goods-list-item-buy {
    position: absolute;
    bottom: 8rpx;
    right: 8rpx;
    width: 44rpx;
    height: 44rpx;
}
.recommending-goods .goods-list-item-buy .van-image {
    width: 100%;
    height: 100%;
}
/** 为你推荐END*/

