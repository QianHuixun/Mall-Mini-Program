										<view class="card_title" data-pkey="{{item.goods}}" data-space="{{subItem.space}}" bindtap="goGoods">
											<view class="card-space">
                        {{subItem.mtypeName == '加工商品' ? '加工:' +subItem.associationName : '规格:' + subItem.spaceName}}
											</view>
										</view>

										<!-- 会员价格与原价 -->
										<view class="price-cell">
											<view>
												<!-- 页面方法调用 -->
												<wxs module="filter" src="./index.wxs"></wxs>
												<view class="normal-price">
													<view class="price_clr">
														<text class="unit">￥</text>
														<text class="price_txt">{{filter.pointFront(subItem.price)}}</text>.{{filter.pointAfter(subItem.price)}}
													</view>
													<view class="price-old">￥<text>{{subItem.priceOld}}</text></view>
												</view>

											</view>
											<view class="card_step">
												<van-stepper value="{{ subItem.num }}" disable-input data-index="{{ index }}" data-space="{{subItem.space}}" data-pkey="{{item.pkey}}" data-spacepkey="{{subItem.pkey}}" data-num="{{subItem.num}}" data-type="mall" async-change bind:change="stepChange" integer min="0" button-size="64rpx"/>
											</view>
										</view>
										<view class="price-mermber" wx:if="{{subItem.priceMember}}">
											<text class="price-mermber-txt"><text class="unit">￥</text>{{subItem.priceMember}}</text>
											<image class="price-mermber-tag" src="/images/member_price_tag.png" />
										</view>
										<!--end 会员价格与原价 -->
									</view>
								</view>

							</view>
						</van-checkbox-group>
					</view>
				</view>

			</van-checkbox-group>
		</view>
	</view>
    <!-- 民生豆 商品 -->
	<view class="buyCar_list market_list" wx:if="{{msdList.length != 0}}">
		<view class="buyCar_title">
			<image class="title-back" src="/images/buyCar/buycar_head.png"></image>
