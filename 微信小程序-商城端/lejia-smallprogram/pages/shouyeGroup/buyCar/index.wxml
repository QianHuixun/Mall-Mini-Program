<!-- 
@url: pages/buyCar/index.wxml
@description: 购物车
@author: sx
@date: 2020/07/20
 -->
 <van-config-provider theme-vars="{{ theme }}">
 <view id="buyCar">
  <drag-ball type="MARKET_MALL"></drag-ball>
	<!-- 市场 商品 -->
	<view class="buyCar_list market_list" wx:if="{{marketList.length != 0}}">
		<view class="buyCar_title">
			<image class="title-back" src="/images/buyCar/buycar_head.png"></image>
			<van-checkbox value="{{ allMarket }}" name="a" checked-color="{{theme.iconColor}}" bind:change="allMarketCheckChange">
				{{marketName}}
			</van-checkbox>
			<view class="collect-bill-box" wx:if="{{(isFree&&allMoney<freeDelivery) || isReductionOne&&allMoney<reachOne || isReductionTwo&&allMoney<reachTwo}}">
				<view class="flex-layout">
                    <van-tag wx:if="{{(isFree && ((isReductionOne &&(allMoney >= reachOne)) || !isReductionOne ) && ((isReductionTwo &&(allMoney >= reachTwo)) || !isReductionTwo ) )}}" custom-class="tag" color="{{theme.tagColor}}" text-color="#ffff" >免跑腿费</van-tag>
					<text wx:if="{{(isFree && ((isReductionOne &&(allMoney >= reachOne)) || !isReductionOne ) && ((isReductionTwo &&(allMoney >= reachTwo)) || !isReductionTwo ) )}}" class="tag-title">满{{freeDelivery}}元包邮</text>
					
                    <text class="tag-title" style="margin-left:0px;" wx:else>满{{isReductionOne && (allMoney < reachOne) ? reachOne : reachTwo}}元，配送费减免{{isReductionOne && (allMoney < reachOne) ? reductionDeliveryOne : reductionDeliveryTwo}}元</text>
				</view>
				<view class="flex-layout " catchtap="gocollectBill"><text style="color: {{theme.primary}}">去凑单</text>
					<van-icon color="{{theme.primary}}" name="arrow" size="1em" />
				</view>
			</view>
		</view>
		<view class="buyCar_content">
			<van-checkbox-group value="{{ marketResult }}" bind:change="groupMarketCheckChange">
				<view id="swipe-cell" wx:for="{{marketList}}" wx:key="pkey">
					<view class="wx_card">
						<view class="card_l" data-index="{{ index }}" data-pkey="{{ item.pkey }}" bindtap="marketToggle">
							<van-checkbox custom-class="buycar-checkbox" name="{{item.pkey}}" checked-color="{{theme.iconColor}}"></van-checkbox>
						</view>
						<view class="card_c" data-pkey="{{item.goods}}" data-space="{{item.lines[0].space}}"  bindtap="goGoods">
							<image src="{{item.photo||'/images/no-pic.png'}}" class="card_img"></image>
							<view class="tip" wx:if="{{item.kcNum<item.num&&item.lines.length<2}}">库存不足</view>
						</view>
						<view class="card_r">
							<view class="card_title" data-pkey="{{item.goods}}" data-space="{{item.lines[0].space}}" bindtap="goGoods">
								<view class="card_title_txt">
									<view class="icon-type" wx:if="{{item.mtype == 'POVERTY_ALLEVIATION_GOODS'|| item.mtype == 'SPECIAL_GOODS'||item.mtype == 'SHARE_GOODS'}}">
										<van-tag color="#ED4528" custom-class="icon-type_tag" plain round text-color="#ED4528" wx:if="{{item.mtype == 'POVERTY_ALLEVIATION_GOODS'}}">扶贫</van-tag>
										<van-tag color="#ED4528" custom-class="icon-type_tag" plain round text-color="#ED4528" wx:elif="{{item.mtype == 'SPECIAL_GOODS'}}">特价</van-tag>
										<van-tag color="#ED4528" custom-class="icon-type_tag" plain round text-color="#ED4528" wx:elif="{{item.mtype == 'SHARE_GOODS'}}">分享</van-tag>
									</view>
									{{ item.goodsTitle }}
								</view>
								<view class="card-space" wx:if="{{item.lines.length<2}}">
									{{item.mtypeName == '加工商品' ? '加工:' +item.associationName : '规格:' + item.spaceName}}
								</view>
							</view>

							<!-- 会员价格与原价 -->
							<view class="price-cell" wx:if="{{item.lines.length<2}}">
								<view>
									<!-- 页面方法调用 -->
									<wxs module="filter" src="./index.wxs"></wxs>
									<view class="normal-price">
										<view class="price_clr">
											<text class="unit">￥</text>
											<text class="price_txt">{{filter.pointFront(item.price)}}</text>.{{filter.pointAfter(item.price)}}
										</view>
										<view class="price-old">￥<text>{{item.priceOld}}</text></view>
									</view>

								</view>
								<view class="card_step">
									<van-stepper value="{{ item.lines[0].num }}" disable-input data-index="{{ index }}" data-space="{{item.lines[0].space}}" data-pkey="{{item.pkey}}" data-num="{{item.num}}" data-type="market" async-change bind:change="stepChange" integer min="0" button-size="64rpx"/>
								</view>
							</view>
							<view class="price-mermber" wx:if="{{item.priceMember&&item.lines.length<2}}">
								<text class="price-mermber-txt"><text class="unit">￥</text>{{item.priceMember}}</text>
								<image class="price-mermber-tag" src="/images/member_price_tag.png" />
							</view>
							<view class="price-sum" wx:if="{{item.lines.length>1}}">小计<text>￥{{item.sumPrice}}</text></view>
							<!--end 会员价格与原价 -->
						</view>
					</view>
					<view class="space-card" wx:if="{{item.lines.length>1}}">
						<van-checkbox-group value="{{ item.marketResult }}" bind:change="marketSpaceChange" data-index="{{index}}">
							<view id="swipe-cell" wx:for="{{item.lines}}" wx:for-item="subItem" wx:for-index="subIndex" wx:key="pkey">
								<view class="wx_card">
									<view class="card_l">
										<van-checkbox custom-class="buycar-checkbox" name="{{subItem.pkey}}" checked-color="{{theme.iconColor}}"></van-checkbox>
									</view>
									<view class="card_c"  data-pkey="{{item.goods}}" data-space="{{subItem.space}}"  bindtap="goGoods">
										<image src="{{subItem.photo1||'/images/no-pic.png'}}" class="card_img"></image>
										<view class="tip" wx:if="{{subItem.kcNum<subItem.num}}">库存不足</view>
									</view>
									<view class="card_r">
										<view class="card_title"  data-pkey="{{item.goods}}" data-space="{{subItem.space}}"  bindtap="goGoods">
											<view class="card-space">
                        {{subItem.mtypeName == '加工商品' ? '加工:' +subItem.associationName : '规格:' + subItem.spaceName}}
											</view>
										</view>

										<!-- 会员价格与原价 -->
										<view class="price-cell">
											<view>
												<!-- 页面方法调用 -->
												<wxs module="filter" src="./index.wxs"></wxs>
												<view class="normal-price">
													<view class="price_clr">
														<text class="unit">￥</text>
														<text class="price_txt">{{filter.pointFront(subItem.price)}}</text>.{{filter.pointAfter(subItem.price)}}
													</view>
													<view class="price-old">￥<text>{{subItem.priceOld}}</text></view>
												</view>

											</view>
											<view class="card_step">
												<van-stepper value="{{ subItem.num }}" disable-input data-index="{{ index }}" data-pkey="{{item.pkey}}"  data-spacepkey="{{subItem.pkey}}" data-space="{{subItem.space}}" data-num="{{subItem.num}}" data-type="market" async-change bind:change="stepChange" integer min="0"  button-size="64rpx" />
											</view>
										</view>
										<view class="price-mermber" wx:if="{{subItem.priceMember}}">
											<text class="price-mermber-txt"><text class="unit">￥</text>{{subItem.priceMember}}</text>
											<image class="price-mermber-tag" src="/images/member_price_tag.png" />
										</view>
										<!--end 会员价格与原价 -->
									</view>
								</view>

							</view>
						</van-checkbox-group>
					</view>

				</view>
			</van-checkbox-group>
		</view>
	</view>
	<!-- 积分商城 商品 -->
	<view class="buyCar_list market_list" wx:if="{{mallList.length != 0}}">
