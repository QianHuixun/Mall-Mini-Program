/* pages/shouyeGroup/memberZone/index.wxss */
page{
  background-color: #f5f5f5;
}

#memer-zone{
  width: 100vw;
  background-color: #f5f5f5;
}

#memer-zone swiper {
  background-color: #fafafa;
  height: calc( 100vw * 0.4266 );
}

#memer-zone swiper swiper-item image {
  width: 100%;
  height: 100%;
}

.top-image {
  display: block !important;
}

.on-member{
  margin: 24rpx;
  background-color: #d9d9d9;
  height: 100rpx;
}

.seg-view {
  margin-top: 20rpx;
  background-color: white;
  height: 76rpx;
  display: flex;
  align-items: center;
}

.seg-view .seg {
  display: flex;
  height: 29rpx;
  /* background-color: #d7a73c; */
  margin: 28rpx;
  flex: 1;
  overflow: hidden;
}
.seg-view .seg .van-image {
  display: block;
}

.seg-view text {
  flex: 1;
  text-align: center;
  color: #d7a73c;
  font-size: 28rpx;
}

.content{
  margin-top: 9rpx;
  background-color: #f5f5f5;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.item {
  width: 31%;
  margin-left: 1.7%;
  height: 510rpx;
  background-color: white;
  margin-bottom: 24rpx;
  text-align: center;
  border-radius: 16rpx;
}

.top-view{
  display: flex;
  align-items: center;
  margin: 18rpx;
}

.top-view text{
  color: #d7a73c;
  font-size: 28rpx;
  margin-left: 12rpx;
}

.item-title{
  color: #5c5c5c;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  width: 90%;
}

.price-member{
  /* margin-top: 12rpx; */
  color: #f24539;
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-size: 28rpx;
}

.num-member{
  font-size: 40rpx;
}

.price-ori{
  color: #999999;
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-size: 21rpx;
}

.num-ori{
  font-size: 28rpx;
  text-decoration: line-through;
}

.btn{
  height: 38rpx !important;
  /* margin-top: 12rpx; */
  font-size: 24rpx !important;
}

.img-cell {
  padding: 24rpx 0 24rpx 0;
  background: #fff;  
}
#memer-zone .lj-image {
  display: block;
  margin: auto;
}
#memer-zone .lj-image image {
  display: block;
}


.lj-grid {
  margin-bottom: 20rpx;
  padding-top: 15rpx;
  padding-bottom: 15rpx;
  background: #fff;
}

.lj-grid .van-grid-item__text {
  margin-top: 19rpx;
  font-size: 26rpx;
}

.lj-grid .van-grid-item__content {
  padding-top: 15rpx;
  padding-bottom: 15rpx;
}

.lj-grid  .van-grid-item__icon {
  height: 85rpx;
}
