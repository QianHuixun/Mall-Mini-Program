/* pages/shouyeGroup/presell/index.wxss */
#presell {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.navbar-back {
  position: relative;
  flex-shrink: 0;
}

.navbar-back>image {
  position: absolute;
  z-index: 0;
  width: 100%;
  height: 88px;
  bottom: 0;
  top: 0;
}

.navbar-back .navbar {
  background-color: transparent;
}

.navbar-back .navbar::after {
  display: none;
}

.navbar-back .navbar .van-icon-arrow-left:before {
  color: #fff;
  font-size: 36rpx;
}

.navbar-back .navbar .van-nav-bar__title {
  color: #fff;
  font-size: 34rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #FFFFFF;
}

.navbar-back .time {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 24rpx;
}

.navbar-back .time .time-title {
  margin-right: 14rpx;
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #FFE7EC;
}

.navbar-back .time .time-top-item-text {
  margin-right: 14rpx;
  font-size: 30rpx;
  color: #FFF5EE;
  line-height: 40 rpx;
}

.navbar-back .time .time-top-item {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  text-align: center;
  background-color: rgba(201, 35, 60, .5);
  color: white;
  font-size: 26rpx;
  line-height: 40rpx;
}

/*  end 头部导航  */
.tab {
  width: 100%;
  height: 78rpx;
  position: relative;
  background: linear-gradient(180deg, #FFFFFF, #FFE7EB);
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.tab image {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
}


.tab .tab-item {
  width: 50%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab .tab-item {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #D68FA3;
  position: relative;
}

.tab .tab-item .jr-tips {
  margin-left: 16rpx;
  width: 108rpx;
  height: 36rpx;
  background: #FE5044;
  opacity: 0.5;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #FFFFFF;
}

.tab .tab-item-active {
  font-size: 32rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #8B1134;
}

.tab .tab-item-active .jr-tips {
  opacity: 1;
}

/* end tab切换栏 */
.scroll-view-box{
  flex: 1;
  background: #F2F4F7;
}
.scroll-view {
  
  /* padding: 0 24rpx; */
  box-sizing: border-box;
}

.mall-goods {
    padding: 0 24rpx;
    background: #FFFFFF;
    position: relative;
    overflow: hidden;
}

.scroll-view .tips {
  width: 100%;
  display: flex;
  justify-content: center;
  font-size: 24rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #F83157;
  padding: 24rpx 0;
  line-height: 24rpx;
}

.scroll-view .goods-item {
  display: flex;
  padding-bottom: 32rpx;
}

.scroll-view .goods-item .goods-image image {
  border-radius: 16rpx;
}

.scroll-view .goods-info {
  padding-left: 16rpx;
  box-sizing: border-box;
  flex: 1;
  width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.scroll-view .goods-name {
  font-size: 28rpx;
  line-height: 28rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
  line-height: 28rpx;
  margin-bottom: 12rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.scroll-view .goods-label {
  width: 80rpx;
  height: 30rpx;
  background: #FFF4F2;
  border: 2rpx solid #ED4528;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #ED4528;
}

.scroll-view .goods-price {
  display: flex;
  justify-content: space-between;
}

.scroll-view .goods-price .goods-price-box {
  display: flex;
  align-items: flex-end;
}

.scroll-view .goods-price .goods-price-box .price-normal {
  font-size: 28rpx;
  line-height: 28rpx;
  font-family: PingFang SC;
  font-weight: 800;
  color: #ED4528;
}

.scroll-view .goods-price .goods-price-box .price-normal text {
  line-height: 40rpx;
  font-size: 40rpx;
}

.scroll-view .goods-price .goods-price-box .price-old {
  font-size: 24rpx;
  line-height: 24rpx;
  font-family: PingFang SC;
  font-weight: 500;
  text-decoration: line-through;
  color: #D68FA3;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
  display: none;
}

.scroll-view .goods-btn {
  height: 64rpx;
  width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.scroll-view .goods-btn.goods-btn-disabled{
  opacity: 0.6;
}
.scroll-view .goods-btn van-image {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
}

.scroll-view .goods-btn text {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 26rpx;
}

.scroll-view .goods-image-box van-image {
  height: 200rpx;
}

.scroll-view .goods-image-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.scroll-view .goods-image-box .no-num {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 26rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #FFFFFF;

}

.scroll-view .goods-progress {
  width: 240rpx;
  height: 26rpx;
  background: linear-gradient(-90deg, rgba(254, 80, 67, 0.6) 0%, rgba(246, 46, 89, 0.6) 100%);
  border-radius: 14rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.scroll-view .goods-progress .progress-curre {
  height: 26rpx;
  background: linear-gradient(-90deg, #FE5043 0%, #F62E59 100%);
  border-radius: 14rpx;
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
}

.scroll-view .goods-progress .progress-num {
  font-size: 20rpx;
  line-height: 20rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #FFFFFF;
  position: relative;
}
.goods-selling_points {
    display: flex;
    align-items: center;
}

.item-selling_points {
    width: 100%;
    margin: 12rpx 0;
    display: flex;
    align-items: center;
    font-size: 28rpx;
    overflow: hidden;
}

.selling-points {
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: #999999;
}

.selling-points + .selling-points::before {
    content: '';
    display: block;
    margin: 0 12rpx;
    width: 1px;
    height: 20rpx;
    background-color: #999999;
}

.item-tag {
    width: fit-content;
    height: fit-content;
    margin-right: 12rpx;
    flex-shrink: 0;
    padding: 2rpx 12rpx;
    font-size: 24rpx;
    background: transparent;
    color: #0DAE4E;
    border: 1px solid #0DAE4E;
    border-radius: 12rpx;
}


.scroll-view .looking-more {
    height: 64rpx;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    color: #333333;
    background: #FFFFFF;
}