/* pages/shouyeGroup/tranceSource/index.wxss */

#tranceSource .van-tabs__wrap,
#tranceSource .van-sticky {
  position: fixed;
  width: 100%;
}

.tab_content {
  margin: 108rpx 10rpx 20rpx 10rpx;
}

#tranceSource .van-tabs__nav--line {
  margin: 0 60rpx;
}

#tranceSource .van-tabs__line {
  width: 130rpx !important;
  height: 4rpx !important;
  height: var(--tabs-bottom-bar-height, 4rpx) !important;
  border-radius: 4rpx !important;
  border-radius: var(--tabs-bottom-bar-height, 4rpx) !important;
  background-color: #01a04c;
  background-color: var(--tabs-bottom-bar-color, #01a04c);
}

#tranceSource .van-tab {
  color: #999;
  font-size: 24rpx;
}

#tranceSource .van-tab--active {
  color: #01a04c;
  font-size: 28rpx;
}

.table {
  border: 1px solid #e4e4ee;
}

.tr {
  display: flex;
  width: 100%;
  justify-content: center;
  align-items: center;
  border-bottom: 1px solid #e4e4ee;
}

.tr:last-child {
  border-bottom: 0;
}   

.td {
  flex: 1;
  /* width:40%; */
  justify-content: center;
  text-align: center;
  font-size: 12px;
  padding: 30rpx 10rpx;
  min-height: 35rpx;
  line-height: 35rpx; 
  align-items: center;
  background: #f7f7f7;
}

.tr.tbody {
  background: #f7f7f7;
}


.tr.tbody.bg-g {
  background: #fff;
}

.td:first-child {
  width: 4rem;
}

.bg-w {
  background: #f8f8ff;
}

.bg-g .td {
  background: #fff;
}

.th {
  flex: 1;
  font-size: 24rpx;
  /* width: 40%; */
  justify-content: center;
  background: #f8f8ff;
  display: flex;
  height: 80rpx;
  align-items: center;
}

.color_red {
  color: #ff2828;
}

