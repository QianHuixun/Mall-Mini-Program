/* pages/shouyeGroup/goodsList/index.wxss */
page {
  background: #f9f9f9;
}

.van-dropdown-menu {
  z-index: 100;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
}

.goodslist {
  margin-top: 100rpx;
  display: flex;
  flex-wrap: wrap;
  padding: 5rpx;
}

.goods-cell {
  width: calc( 50% - 20rpx );
  box-sizing: border-box;
  margin: 10rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.goods-con {
  background: #fff;
  padding: 10rpx 10rpx 10rpx 20rpx;
}

.goods-cell .goods-image {
  width: 100%;
  height: calc(50vw - 5rpx - 20rpx - 20rpx);
}

.title-cell {
  height: 72rpx;
  line-height: 36rpx;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
}

.price-cell .price {
  flex: 1;
  font-size: 28rpx;
  display: flex;
}
.price_clr_item{
  flex: 1;
}
.price-cell .price  text {
  font-size: 36rpx;
}
.price_clr .point{
  font-size: 24rpx ;
}
.price_old{
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}
.price_member {
  flex: 1;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #4dce78;
}

.price_member_txt {
  display: inline_block;
  margin-right: 16rpx;
}

.price_member_tag{
  width: 70rpx;
  height: 30rpx;
}
.price_box{
  flex: 1;
  display: flex;
  align-items: center;
}