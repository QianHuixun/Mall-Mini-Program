page{
  background: #e1082d;
}
.coupon{
  position: relative;
  background: url(data:image/png;base64,);
  background-size: 100% 100%;
  background-repeat: no-repeat;
}
.navbar {
  display: flex;
  justify-content: center;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  right:0;
  background-color: #e1082d;
}
.navbar .back-home{
  position: absolute;
  left: 20rpx;
   width: 50rpx;
   height: 50rpx;
   border-radius: 50%;
   background: rgba(255,255, 255, 0.2);
   border: 2rpx solid rgba(255,255, 255, 0.3);
   display: flex;
   align-items: center;
   justify-content: center;
}
.navbar .back-home image{
  width: 60%;
  height: 60%;
}

.content{
  position: absolute;
  top: 300px;
  left: 0;
  right:0;
  padding:0 30rpx 40rpx 30rpx;
}
.content .card-box{
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 160rpx;
  padding:10rpx 14rpx 10rpx 40rpx ;
  margin-bottom: 20rpx;
  background: url('data:image/png;base64,') ;
  background-size: 100% 100%;
  background-repeat: no-repeat;
  color:#f6ac4d;
  font-size:28rpx;
}
.card-box .left .tit{
   padding-bottom: 10rpx;
}
.card-box .left .atm{
  padding-bottom: 10rpx;

}
.card-box .left .atm .num{
  font-size:40rpx;
  font-weight: bold;
}
.card-box .left .label{
  font-size:24rpx

}
.card-box  .left.label text{
  display: inline-block;
  padding-left: 10rpx;
}
.card-box .right button{
  width: 130rpx;
  height: 130rpx;
  padding:0;
  border: none;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
  color:#f6ac4d;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-box .right image {
  width: 130rpx;
  height: 100rpx;
}
