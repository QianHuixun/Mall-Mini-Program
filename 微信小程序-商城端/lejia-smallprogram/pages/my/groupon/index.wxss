page {
  background: #fafafa;
}

.tab-box {
  padding-top: 20rpx;


}

.item-box {
  padding: 20rpx 15px;
  background: #fff;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.item-box .focus {
  font-size: 32rpx;
  color: #f24539;
}

.item-box .item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 60rpx;
  color: #5c5c5c;
}

.item-box .item-top .market {
  color: #000;
}

.item-box .item-center {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
}

.item-box .item-center .item-left {
  width: 200rpx;
  height: 200rpx;
  margin-right: 40rpx;
}
.item-center .item-right{
  height: 200rpx;
  flex: 1;
}
.item-center .item-right .name {
  margin: 10rpx 0 34rpx 0;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 38rpx;
  overflow: hidden;
}
.item-center .item-right .label{
  color: #5c5c5c;
}
.item-box .item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
}
.item-box .item-bottom .time-top-item-text {
  margin: 0 7rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  color: #969696;
}

.item-box .item-bottom .time-top-item {
  display: inline-block;
  /* width: 40rpx; */
  padding: 0 6rpx;
  /* margin-right: 14rpx; */
  border-radius: 10rpx;
  text-align: center;
  background-color: #000;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
  padding-right: 3px;
}
.item-box .item-bottom .btn-box {
  display: flex;
  align-items: center;
  margin: 0 0 0 10px;

}

.item-bottom .btn-box .btn {
  display: inline-block;
  color: #fff;
  background: #f24539;
  border-color: #f24539;
  height: 30px;
  /* width: 140rpx; */
  font-size: 12px;
  border-radius: 999px;

}