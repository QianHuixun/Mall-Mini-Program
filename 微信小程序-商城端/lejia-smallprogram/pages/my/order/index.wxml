						</view>
            <view class="card_goods_amt">
              <view class="card_goods_amt_price">￥{{item.amtn}}</view>
              <view class="card_goods_amt_num">共{{item.orderNum}}件</view>
            </view>
					</view>
					<view class="card_con" data-pkey="{{item.pkey}}" data-index="{{index}}" bindtap="goDetail" wx:if="{{item.list1.length == 1 || item.list2.length == 1}}"	>
						<view class="card_goods_list" wx:for="{{ item.orderOir == 'MARKET_MALL' ? item.list2 : item.list1}}" 	wx:key="index" wx:for-item="subitem" wx:if="{{item.list1.length == 1 || item.list2.length == 1}}">
							<view class="card_l">
								<van-image custom-class="goods_image" src="{{subitem.photo||'/images/no-pic.png'}}" />
							</view>
							<view class="card_c">
								{{subitem.goodsName}}
                <view class="card_c_specs" wx:if="{{subitem.spaceName}}">
                  规格:{{subitem.spaceName}}
                </view>
							</view>
							<view class="card_r">
                <view class="price_clr">￥{{subitem.price}}</view>
								<view class="gray_clr">x{{subitem.num}}</view>
							</view>
						</view>
					</view>
          <view class="card_date">
            <view class="card_date_left">{{item.createdTime}}</view>
            <view class="card_date_right" wx:if="{{item.distributionType !== 'PICKUP' && item.status == 'SHIPPED_ORDER' && item.pickupCode}}">
            <text>收货码</text> 
            <text class="code_green">{{item.pickupCode}}</text>
            </view>
          </view>
          <!-- <view class="card_refund">
            退款成功 退款成功￥8.00
          </view> -->
				</view>
			</view>
		</van-tab>
	</van-tabs>
	<load-more id="loadMoreView" bindloadMoreListener='loadMoreListener' bindclickLoadMore='clickLoadMore'></load-more>
	<van-dialog id="van-dialog"></van-dialog>
	<!-- 在页面的任意位置 加上这个组件并绑定 onLoadFun函数 和 isAuto 为授权不会自动登录默认值为：false
iShidden=true 隐藏授权 -->
	<authorize bind:onLoadFun="onLoadFun" isAuto="{{ isAuto }}" iShidden="{{ iShidden }}"></authorize>
</view>