/* pages/my/cardWhiteOff/index.wxss */
#cardWhiteOff {
  width: 100vw;
  height: 100vh;
  background-color: #F2F4F7;
  padding-top: 24rpx;
}

.card-item {
  width: 702rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx 0 24rpx;
  box-sizing: border-box;
}
.card-box {
  display: flex;
}

.card-box .card-price {
  width: 190rpx;
  height: 152rpx;
  background: linear-gradient(90deg, #FF9E1D, #FDB32F);
  border-radius: 16rpx;
  padding-top: 32rpx;
  margin-right: 24rpx;
  box-sizing: border-box;
}

.card-box .card-price .card-price-title {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-bottom: 24rpx;
}

.card-box .card-price .card-price-title .unit {
  font-size: 32rpx;
  line-height: 32rpx;

  font-family: PingFang SC;
  font-weight: bold;
  color: #FFFFFF;
}

.card-box .card-price .card-price-title view {
  display: inline-block;
  font-size: 56rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 46rpx;
}

.card-box .card-price .card-price-label {
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #FFFFFF;
  text-align: center;
}

.card-box .card-info {
  flex: 1;
  width: 0;
}

.card-box .card-info .card-title {
  padding-top: 8rpx;
  padding-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
  line-height: 30rpx;
}

.card-box .card-info .card-time {
  font-size: 24rpx;
  line-height: 24rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;
  padding-bottom: 22rpx;
}

.card-box .card-info .card-rule {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-box .card-info .card-rule .card-rule-title {
  display: flex;
  align-items: center;
}

.card-box .card-info .card-rule .card-rule-title text {
  display: inline-block;
  line-height: 24rpx;
  font-size: 24rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;
  padding-right: 12rpx;
}

.card-box .card-info .card-rule .card-rule-title .van-icon {
  color: #999999;
  transition: transform 0.3s
}

.card-box .card-info .card-rule .card-rule-title .rule {
  transform: rotate(180deg);
}

.card-box .card-info .card-rule .card-button {
  width: 120rpx;
  height: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid #63BF57;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #63BF57;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0
}


.card-item .card-rule-box {
  height: 0;
  overflow: hidden;
  box-sizing: border-box;
  transition: height 0.3s ease-in-out;
}

.card-item .card-rule-box view, .card-item .card-rule-box text {
  font-size: 24rpx;
  line-height: 26rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;
  overflow-wrap: break-word;
  word-wrap: break-word; /* 允许在长单词或URL中间换行 */
}

.card-item .card-rule-box view+view {
  margin-top: 10rpx;
}

.card-item .card-rule-box view:first-child {
  padding-top: 24rpx;
}

.card-item .card-rule-box.not-collapse.height-auto {
  height: auto;
}

.card-item .van-image {
  margin-right: 24rpx;
  display: block;
}

.card-button {
  padding: 80rpx 48rpx;
}

.card-error {
  padding: 144rpx 60rpx;
  text-align: center;
}

.card-error-msg {
  padding-top: 32rpx;
  font-weight: 500;
  font-size: 32rpx;
  color: #666666;
}

.card-success {
  text-align: center;
  padding-top: 144rpx;
  padding-bottom: 80rpx;
}
.card-success-msg {
  padding-top: 32rpx;
  font-weight: bold;
  font-size: 32rpx;
  color: #0DAE4E;
}

.card-box .card-price {
  width: 190rpx;
  height: 152rpx;
  background: linear-gradient(90deg, #FF9E1D, #FDB32F);
  border-radius: 16rpx;
  padding-top: 32rpx;
  margin-right: 24rpx;
  box-sizing: border-box;
}

.card-box .card-price .card-price-title {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-bottom: 24rpx;
}

.card-box .card-price .card-price-title .unit {
  font-size: 32rpx;
  line-height: 32rpx;

  font-family: PingFang SC;
  font-weight: bold;
  color: #FFFFFF;
}

.card-box .card-price .card-price-title view {
  display: inline-block;
  font-size: 56rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 46rpx;
}
.card-box .card-price .card-price-title .free {
font-size: 34rpx;
}
.card-box .card-price .card-price-label {
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #FFFFFF;
  text-align: center;
}