<!-- 
@url: pages/my/address/edit/index.wxml
@description: 收货地址 -- 编辑页面
@author: sx
@date: 2020/07/19
 -->
<view id="edit">
    <van-cell-group>
        <van-field label="收货人" value="{{ inputModel.name }}" data-value="name" placeholder="请输入收货人" bind:change="filedChange" />
        <van-field label="手机号码" value="{{ inputModel.mobile }}" data-value="mobile" placeholder="请输入手机号码" bind:change="filedChange" />
        <van-field label="所在地区" wx:if="{{!isPickup}}" value="{{ inputModel.region }}" readonly placeholder="省市区" data-type="prov" bind:click-input="showPopup" bind:click-icon="chooseAddr">
            <view class="icon-box" slot="right-icon">
                <van-icon name="aim" style="margin-right: 6rpx;" />定位
            </view>
        </van-field>
        <van-field label="所属街道" wx:if="{{!isPickup && (ascription == 13 || ascription == 22)}}" value="{{ inputModel.town }}" readonly data-type="area" bind:click-input="showPopup" placeholder="请选择所属街道"/>
        <van-field label="详细地址" type="textarea" wx:if="{{!isPickup}}" value="{{ inputModel.addr }}" placeholder="请选择收货地址" autosize="{{true}}" bind:click-input="addrTap" bind:change="addrChange" />
    </van-cell-group>
    <van-cell-group>
        <van-cell title="设置默认" label="提醒：每次下单会默认推荐使用该{{isPickup ? '自提联系人' : '地址'}}">
            <van-switch checked="{{ inputModel.defaultAddr }}" size="20px" bind:change="switchChange" active-color="#0DAE4E" />
        </van-cell>
    </van-cell-group>

    <view class="action_container">
        <van-button round loading="{{ loading }}" color="#0DAE4E" disabled="{{ disabled }}" type="primary" bind:click="handleSubmit">保存</van-button>
        <view class="action_del" wx:if="{{type== 'edit'}}"><text bind:tap="handleDelete">删除</text></view>
    </view>
    <van-popup show="{{ show }}" bind:close="onClose" position="bottom">
        <van-area wx:if="{{popupType == 'prov'}}" area-list="{{ areaList }}" columns-placeholder="{{ ['请选择', '请选择', '请选择'] }}" value="{{ inputModel.addrCode }}" title="所在地区" bind:confirm="areaConfirm" bind:cancel="onClose" />
        <van-picker wx:else show-toolbar title="所属街道" columns="{{ columns }}" value-key="areaName" bind:confirm="handleAreachange" bind:cancel="onClose" />
    </van-popup>

    <!-- <view class="action_container">
		<van-goods-action safe-area-inset-bottom="{{ true }}">
			<van-goods-action-button icon="plus" text="保存" loading="{{ loading }}" disabled="{{ disabled }}" />
		</van-goods-action>
	</view> -->

    <!-- 在页面的任意位置加上这个组件并绑定 onLoadFun函数 和 isAuto 为授权不会自动登录默认值为：false
        iShidden=true 隐藏授权 -->
    <authorize bind:onLoadFun="onLoadFun" isAuto="{{isAuto}}" iShidden="{{iShidden}}"></authorize>
    <van-dialog id="van-dialog" />
</view>