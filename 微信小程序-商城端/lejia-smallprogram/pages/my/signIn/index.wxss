/* pages/my/signIn/index.wxss */
page {
  background: #f5f5f5;
}

.topContainer {
  position: relative;
  width: 100%;
  padding: 40rpx 0  100rpx 0;
}

.top_btn {
  z-index: 1;
  position: relative;
  width: 200rpx;
  height: 200rpx;
  background: none;
  border:0;
  line-height: 200rpx;
  border-radius: 50%;
  -webkit-tap-highlight-color: none;
  background: url("data:image/png;base64,") center center no-repeat; background-size: 100% 100%;
}

.top_bg {
  z-index: 0;
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.top_text {
  z-index: 1;
  position: relative;
  display: block; 
  padding: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
}

.numContaner {
  z-index: 10;
  position: relative;
  display: flex;
  margin: -70rpx 20rpx 20rpx 20rpx;
  padding: 30rpx 0;
  border-radius: 10rpx;
  background: #fff;
}

.numContaner .num_cell {
  flex: 1;
  text-align: center;
}
.numContaner .num_cell:first-child {
  border-right: 1px solid #efefef;
}

.num_cell .num {
  font-size: 72rpx;
}
.numContaner .i_icon {
  width: 35rpx;
  height: 35rpx;
  margin-right: 10rpx;
}
.num_cell .tips image {
  margin-bottom: -5rpx;
}

.num_cell .tips {
  line-height: 35rpx;
  font-size: 28rpx;
  color: #666666;
}

.dateContainer {
  margin: 30rpx 20rpx;
  background: #fff;
  border-radius: 10rpx;
}

.calen_header {
  position: relative;
  height: 70rpx;
  line-height: 70rpx;
  border-bottom: 2px solid #f5f5f5;
  text-align: center;
}

.calen_header button {
  position: relative;
  display: inline-block;
  background: none;
  border: none;
  -webkit-tap-highlight-color: none;
  height: 70rpx;
  text-align: center;
}

button::after {
  border:0;
}

.calen_header .van-icon {
  position: absolute;
  top: 0;
  left: 0;
  height: 70rpx;
  line-height: 70rpx;
  margin-top: 2rpx;
}

.calendar_month_prev .van-icon {
  transform:rotate(180deg); 
  -ms-transform:rotate(180deg); /* IE 9 */ 
  -moz-transform:rotate(180deg);
}
.calendar_month_prev .van-icon {
  margin-top: 5rpx;
}

.calen_header .txt {
  display: inline-block;
  position: relative;
  top: -22rpx;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
  color: "#333333";
  margin: 0 50rpx 0 35rpx;
}


.calendar_wrapper {
  padding: 30rpx;
}
.week_day,
.month_day {
  display: flex;
}

.weeklist,
.day_list {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 60rpx;
}

.listContaner {
  margin: 30rpx 20rpx;
  background: #fff;
  border-radius: 10rpx;
}

.day_hover {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  line-height: 36rpx;
  text-align: 36rpx;
  background: #e6ffee;
  color: #4dce78;
  
}