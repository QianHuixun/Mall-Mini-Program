/* pages/my/refundDetail/index.wxss */
page {
  background: #f6f6f6;
}

#orderDetail {
    padding-bottom: 180rpx;
}

.status_container {
  position: relative;
}

.status_cell {
  background: transparent;
  margin-bottom: 0;
  padding: 40rpx 32rpx 40rpx 42rpx;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}


.status_cell_status {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.status_cell_status .status_text {
  font-size: 48rpx;
  line-height: 48rpx;
  margin-bottom: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.status_cell_status .delivery_type {
  max-width: 580rpx;
  word-wrap: break-word;
  font-size: 26rpx;
  font-size: 13px;
  font-family: PingFang SC;
  font-weight: bold;
  color: #999999;
}

.status_cell .delivered_order_img {
  width: 96rpx;
  height: 96rpx;
}

.status_cell_confirm .delivered_order_img {
  width: 96rpx;
  height: 96rpx;
}


.status_cell_confirm .delivery_type {
  font-size: 26rpx;
  color: #999999;
}

.status_cell .delivered_order_pickupcode {
  width: 280rpx;
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;

}

.status_cell .delivered_order_pickupcode image {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 100%;
}


.status_cell_status {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.status_cell_status .status_text {
  font-size: 48rpx;
  line-height: 48rpx;
  margin-bottom: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.status_cell_status .delivery_type {
  font-size: 26rpx;
  font-size: 13px;
  font-family: PingFang SC;
  font-weight: bold;
  color: #999999;
}

.mall-cell {
    padding: 16rpx;
    margin: 0 24rpx 20rpx 24rpx;
    color: #333333;
    background: linear-gradient( 180deg, #08BB8D 0%, #52CBAC 100%);
    border-radius: 24rpx;
    box-sizing: border-box;
}

.mall-cell-title {
    height: 40rpx;
    line-height: 40rpx;
    font-weight: bold;
    font-size: 28rpx;
    color: #FFFFFF;
}

.mall-cell-content {
    margin-top: 16rpx;
    padding: 16rpx;
    background: #FFFFFF;
    border-radius: 24rpx;
    box-sizing: border-box;
}

.fill-in-box {
    height: 144rpx;
    padding: 24rpx;
    display: flex;
    position: relative;
    background: #F2FBF9;
    border-radius: 16rpx;
    border: 2rpx solid #09AF84;
    box-sizing: border-box;
}

.fill-in-image {
    width: 96rpx;
    height: 96rpx;
    margin-right: 16rpx;
}

.fill-in-text {
    padding-top: 10rpx;
}

.fill-in-text__head {
    height: 40rpx;
    line-height: 40rpx;
    font-weight: bold;
    font-size: 28rpx;
    color: #333333;
}

.fill-in-text__sub {
    height: 36rpx;
    line-height: 36rpx;
    margin-top: 6rpx;
    font-size: 26rpx;
    color: #999999;
}

.fill-in-btn {
    width: 164rpx;
    height: 68rpx;
    line-height: 68rpx;
    position: absolute;
    top: 42rpx;
    right: 24rpx;
    text-align: center;
    font-size: 26rpx;
    color: #FFFFFF;
    background: linear-gradient( 90deg, #0FC697 0%, #0DCCAB 100%);
    border-radius: 40rpx;
}

.mall-cell-addr {
    display: flex;
    justify-content: space-between;
    height: 40rpx;
    line-height: 40rpx;
    margin: 20rpx 0 16rpx;
    font-size: 28rpx;
}

.mall-cell-addr__copy {
    font-size: 26rpx;
    color: #09AF84;
}

.mall-cell-addr-box {
    padding: 20rpx;
    font-size: 26rpx;
    color: #7889A2;
    background: #F2F4F7;
    border-radius: 16rpx;
    box-sizing: border-box;
}

.mall-cell-addr-contact {
    height: 36rpx;
    line-height: 36rpx;
}

.mall-cell-addr-detail {
    margin-top: 8rpx;
    line-height: 36rpx;
}

.return-logistics {
    height: 216rpx;
    padding: 0 24rpx;
    margin: 0 24rpx 20rpx 24rpx;
    color: #333333;
    background: #FFFFFF;
    border-radius: 24rpx;
}

.return-logistics-title {
    height: 72rpx;
    line-height: 72rpx;
    font-weight: bold;
    font-size: 28rpx;
    border-bottom: 1px solid #F0F0F0;
}

.return-logistics-content {
    padding: 24rpx 0;
    font-size: 28rpx;
}

.return-logistics-content > view + view {
    margin-top: 16rpx;
}

.goods_cell {
  margin: 0 24rpx 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}


.card_con {
  padding: 0 24rpx;

}

.card_con>.title {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
  padding: 24rpx 0 32rpx 0;
}

.goods-list {
  overflow: hidden;
  box-sizing: border-box;
  transition: height 0.3s ease-in-out;
}


.card_goods_list+.card_goods_list {
  margin-top: 32rpx;
}

.card_goods_list .card_c,
.card_footer .card_l {
  flex: 1;
}


.card_goods_list .card_c {
  flex: 1;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.card_goods_list .card_c .card_c_name {
  font-size: 28rpx;
  line-height: 36rpx;
  height: 72rpx;
  overflow: hidden;

}

.card_goods_list .card_c .card_c_space {
  color: #999;
}


.card_goods_list .card_r {
  font-size: 24rpx;
  text-align: right;
}

.card_goods_list .van-image {
  display: block;
  margin-right: 16rpx;
}


.card_goods_item {
  display: flex;
}


.card_goods_item__title {
  font-weight: bold;
  font-size: 30rpx;
  color: #333333;
  line-height: 46rpx;
  height: 46rpx;
  width: 492rpx;
  overflow: hidden; /* 超出部分隐藏 */
  text-overflow: ellipsis; /* 添加省略号表示被裁切的文本 */
  white-space: nowrap; /* 保持单行显示 */
}

.card_goods_item__space {
  font-weight: 400;
  font-size: 24rpx;
  color: #999999;
  line-height: 26rpx;
  display: flex;
  align-items: center;
}

.card_goods_item__space__left {
  flex: 1;
}

.card_goods_item__space__right {
  text-align: right;
}

.card_goods_item__price {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.card_goods_item__price__left {
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
  line-height: 28rpx;
}

.card_goods_item__price__right {
  flex: 1;
  font-weight: 400;
  font-size: 24rpx;
  color: #ED4528;
  line-height: 28rpx;
  text-align: right;
}

.card_goods_item__right {
  flex: 1;
}

.card_goods_items .card_goods_item__price {
    margin-top: 58rpx;
}

.card_goods_items .card_goods_item__price__left .card_goods_item__price__left___xiaoji {
  display: inline-block;
  height: 40rpx;
  background: #F7F7F7;
  border-radius: 20rpx;
  line-height: 40rpx;
  padding: 0 14rpx;
  font-size: 26rpx;
}

.fs-22 {
  font-size: 22rpx;
  color: #333333;
}

.card_goods_item_lines {
  margin-top: 24rpx;
  margin-left: 50rpx;
  display: flex;
}

.card_goods_item_lines___right {
  flex: 1;
}

.card_goods_item_lines .card_goods_item__space__left {
  flex: 1;
}
.card_goods_item_lines  .card_goods_item__space {
  font-size: 24rpx;
  color: #999999;
  line-height: 26rpx;
  display: flex;
}

.card_goods_item_lines  .card_goods_item__price {
  margin-top: 16rpx;
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
  line-height: 28rpx;
}


.card_price {
  margin: 0 26rpx;
  font-size: 28rpx;
  padding-bottom: 24rpx;
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 1px solid #F0F0F0;
}

.card_price .card_cell {
  margin-top: 0;
}

.card_cell {
  display: flex;
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 400;
  color: #333333;
  margin-top: 30rpx;
  line-height: 32rpx;
  padding: 8rpx 0;
}

.card_price .card_cell .card_l {
  flex: 1;
}

.card_price .card_cell .strikeout {
  text-decoration: line-through;
}



.info_cell {
  padding: 0 24rpx 32rpx 24rpx;
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.info_cell>.title {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
  padding: 24rpx 0 24rpx 0rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.info_cell .card_l {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #333333;
  margin-right: 40rpx;
  white-space: nowrap;
  min-width: 4em;
}

.info_cell .card_r {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #333333;
}

.flex {
  flex: 1;
  display: flex;
}

.card_cell .card_r_l {
  flex: 1;
}

.card_cell .card_r_r {
  color: #0DAE4E;
}


.look-more {
  font-size: 24rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 40rpx;
}

.card_tips {
  text-align: right;
  font-weight: 500;
  font-size: 24rpx;
  color: #999999;
}

.look-more text {
  display: inline-block;
  margin-right: 10rpx;
}

.color_red {
  font-weight: bold;
  font-size: 28rpx;
  color: #ED4528;
}

.info_phone {
  font-weight: 500;
  font-size: 26rpx;
  color: #666666;
  line-height: 30rpx;
  text-align: center;
  padding: 34rpx 0 60rpx 0;
}

van-image+van-image {
  margin-left: 12rpx;
}

.btn_cell {
    position: fixed;
    z-index: 1000;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 146rpx;
    box-sizing: border-box;
    padding: 16rpx 20rpx;
    background: #fff;
    border-top: 1px solid #f9f9f9;
    text-align: right;
  }
  
  .btn_cell .van-button {
    margin-right: 15rpx;
  }

  .refund_btn {
    font-weight: 400 !important;
    font-size: 30rpx !important;
    color: #333333 !important;
    height: 76rpx !important;
    padding: 0 60rpx  !important;
    border-radius: 38rpx !important;
    background: #ffffff;
    border: 1rpx solid #F0F0F0;
  }
  .refund-font-color {
    color: #ED4528;
  }