/* pages/my/openVip/index.wxss */
page {
  background: #f5f5f5;
}
#openVip{
  padding-bottom: 136rpx;
}
.top_image {
  width: 100%;
  height: auto;
  display: block;
}

.seg-view {
  position: relative;
  z-index: 50;
  /* top: -80rpx; */
  margin: 0 45rpx 20rpx 45rpx;
  background-color: white;
  height: 70rpx;
  display: flex;
  align-items: center;
  border-top-left-radius: 8rpx;
  border-top-right-radius: 8rpx;
}


.seg-view .seg {
  display: flex;
  height: 29rpx;
  /* background-color: #d7a73c; */
  margin: 28rpx;
  flex: 1;
  overflow: hidden;
}
.seg-view .seg .van-image {
  display: block;
}

.seg-view text {
  flex: 1;
  text-align: center;
  color: #d7a73c;
  font-size: 28rpx;
}


.content{
  position: relative;
  /* top: -80rpx; */
  margin: 24rpx 45rpx 0 45rpx;
  background-color: #f5f5f5;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.item {
  width: 31%;
  margin-left: 1.7%;
  height: 510rpx;
  background-color: white;
  margin-bottom: 24rpx;
  text-align: center;
  border-radius: 16rpx;
}

.top-view{
  display: flex;
  align-items: center;
  margin: 18rpx;
}

.top-view text{
  color: #d7a73c;
  font-size: 28rpx;
  margin-left: 12rpx;
}

.item-title{
  color: #5c5c5c;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  width: 90%;
}

.price-member{
  /* margin-top: 12rpx; */
  color: #f24539;
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-size: 26rpx;
}

.num-member{
  font-size: 34rpx;
}

.price-ori{
  color: #999999;
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-size: 21rpx;
}

.num-ori{
  font-size: 28rpx;
  text-decoration: line-through;
}

.btn{
  height: 38rpx !important;
  /* margin-top: 12rpx; */
  font-size: 24rpx !important;
}

.xcx_header { 
  position: relative;
  margin-bottom: 20rpx;
}
.xcx_header__content{
  background: #fff;
}
.xcx_bottom__btn {
  z-index: 100;
  position: fixed;
  bottom: 0rpx;
  left: 0;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  padding:20rpx 0rpx;

}

#openVip .new-action {
  position: relative;
  padding: 0 50rpx;
  background: none;
}

#openVip .new-action .van-goods-action-button--first button {
  border-top-left-radius: 48rpx;
  border-bottom-left-radius: 48rpx;
}

#openVip .new-action .van-goods-action-button--last button {
  border-top-right-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

#openVip .new-action button {
  height: 96rpx;  
}

#openVip .new-action .van-button__text {
  color: #d7b782;
  font-size: 32rpx;
}

.xcx_header__btn___text {
  z-index: 10;
  position: absolute;
  top: 0;
  left: 0;
  width: calc( 50% - 50rpx );
  height: 96rpx;
  padding: 20rpx 50rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  color: #2c2419;
}

.xcx_header__btn___text .price {
  font-size: 56rpx;
}

.xcx_header__btn___text .del_text {
  color: #2c2419;
  opacity: 0.5;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.xcx_header__btn__icon {
  position: absolute;
  z-index: 10;
  top: 6rpx;
  left: 150rpx;
}

.top_icon {
  width: 136rpx;
  height: 32rpx;
}

.xcx_header__date {
  padding-top: 15rpx;
  padding-bottom: 20rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  
}