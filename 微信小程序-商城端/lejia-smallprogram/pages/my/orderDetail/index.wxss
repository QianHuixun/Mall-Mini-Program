  align-items: center;
  justify-content: space-between;
}

.status_cell_status {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.status_cell_status .status_text {
  font-size: 48rpx;
  line-height: 48rpx;
  margin-bottom: 22rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.status_cell_status .delivery_type {
  font-size: 26rpx;
