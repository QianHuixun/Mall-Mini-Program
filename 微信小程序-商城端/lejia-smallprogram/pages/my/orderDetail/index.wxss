  font-family: PingFang SC;
  font-weight: bold;
  color: #999999;
}

.status_cell .delivered_order_img {
  width: 96rpx;
  height: 96rpx;
}

.status_cell_confirm .delivered_order_img {
  width: 96rpx;
  height: 96rpx;
}

.delivered_order_img.refund_rorder_img {
  width:  120rpx;
  height: 96rpx;
}

.status_cell_confirm .delivery_type {
  font-size: 26rpx;
  color: #999999;
}

.status_cell .delivered_order_pickupcode,.status_cell .delivered_order_ts {
  width: 300rpx;
  height: 120rpx;
  /* border: 4rpx solid #B5FFCB; */
  /* background: #0B9936; */
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  text-align: center;
}

.status_cell .delivered_order_pickupcode image,.status_cell .delivered_order_ts image,.status_cell_confirm .delivered_order_ts image{
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 100%;
}


.delivered_order_pickupover {
  width: 280rpx;
  height: 120rpx;
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #999999;
