  align-items: center;
  justify-content: center;
  position: relative;
}
.delivered_order_pickupover image {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 100%;
}

.status_cell_confirm .delivered_order_pickupcode {
  width: 220rpx;
  height: 120rpx;
