  margin-top: -48rpx;
}
.hasMap .status_cell {
  padding-top: 58rpx;
}
.go_map {
  position:absolute;
  width: 100%;
  height: 42rpx;
  top: 0;
  text-align: center;
}
.go_map:before {
  position: absolute;
  display: inline-block;
  content: "";
  width: 60rpx;
  height: 5rpx;
  border-radius: 2.5rpx;
  background-color: #CCCCCC;
  top: 10rpx;
  left: calc(50% - 30rpx);
}

.customCallout {
  /* position: relative; */
  background-color: #fff; 
  box-shadow: 0rpx 6rpx 12rpx 2rpx rgba(153,153,153,0.16);
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
}

.customCallout:before {
  /* z-index: 1000; */
  position: absolute;
  display: block;
  content: '';
  width: 0;
  height: 0;
  bottom: -15rpx;
  left: calc( 50% - 15rpx);
  border-top: 15rpx solid #fff;
  border-right: 15rpx solid transparent;
  border-left: 15rpx solid transparent;
  border-bottom: 0;
  box-shadow: 0rpx 6rpx 12rpx 2rpx rgba(153,153,153,0.16);
}

