  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.status_cell_confirm .delivered_order_ts {
  position:relative;
  width: 300rpx;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.delivered_order_pickupcode .pickupcode, .delivered_order_ts  .pickupcode{
