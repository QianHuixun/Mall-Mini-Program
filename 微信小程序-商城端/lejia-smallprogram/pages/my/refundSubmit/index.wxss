/* pages/my/refundSubmit/index.wxss */
page {
  background: #F2F4F7;
}

.refund_button {
  z-index: 1000;
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 184rpx;
  background: #fff;
  box-sizing: border-box;
  padding: 20rpx 24rpx 88rpx 24rpx;
  border-top: 1px solid #F0F0F0;
}

.refund_button .van-button {
  width: 100%;
  height: 76rpx;
  background: #0DAE4E;
  border-radius: 38rpx;
  font-weight: bold;
  font-size: 30rpx;
  color: #FFFFFF;
}

.info_phone {
  font-weight: 500;
  font-size: 26rpx;
  color: #666666;
  line-height: 30rpx;
  text-align: center;
  padding: 34rpx 0 60rpx 0;
}

#refund_submit {
  padding: 0 24rpx 190rpx 24rpx;
}

.refund_goods {
  background: #FFFFFF;  
  border-radius: 24rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.refund_box {
  background: #FFFFFF;  
  border-radius: 24rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  overflow: hidden;
}

.refund_box_title {
  height: 72rpx;
  line-height: 72rpx;
  border-bottom: 1px solid #F0F0F0;
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
}

.icon_star {
  font-weight: bold;
  font-size: 28rpx;
  color: #ED4528;
}

.van-cell-text {
  font-weight: 500;
  font-size: 28rpx;
  color: #333333;
}

.van-cell-value {
  font-weight: 400;
  font-size: 28rpx;
  color: #333333;
}

.van-cell-value_flex {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.van-cell-value_flex van-image {
  height: 90rpx;
  overflow: hidden;
  width: 90rpx;
  border-radius: 8rpx;
}

.van-cell-value text {
  margin-left:16rpx;
}

van-image {
  display: block;
}

van-image+van-image {
  margin-left: 8rpx;
}

.van-cell {
  align-items: center;
  padding: 24rpx 24rpx !important;
}

.van-icon-arrow {
  color: #333333 !important;
}

.refund_box_list {
  padding-top: 16rpx;
}

.refund_box_list .van-cell {
  padding-right: 0 !important;
  padding-top: 16rpx !important;
  padding-bottom: 16rpx !important;
  background: #FAFBFD;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.van-cell__title {
  color: #333 !important;
}

.van-radio__icon--checked {
  background-color: #0DAE4E !important;
  border-color: #0DAE4E !important;
}

.refund_box_form .van-cell {
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.van-field__body--textarea textarea{
  color: #333 !important;
  font-weight: 400 !important;
font-size: 28rpx !important;
  height: 240rpx !important;
  padding: 16rpx 24rpx !important;
  background: #F7F7F7;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
  border: 1rpx solid rgba(204,204,204,0.5);
}
.upload-icon {
  box-sizing: border-box;
  padding-top: 18rpx;
  width: 140rpx;
  height: 140rpx;
  background: #F7F7F7;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
  border: 1rpx solid rgba(204,204,204,0.5);
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  font-weight: 400;
}

.van-uploader {
  padding-top: 8rpx;
  padding-bottom: 32rpx;
}

.success_tips {
  position: fixed;
  z-index: 999;
  top:0;
  left: 0;
  width: 100vw;
  height: 100vh;
  padding-top: 144rpx;
  background: #F2F4F7;
  text-align: center;
}

.success_tips .success_text {
  margin-top: 32rpx;
  font-weight: bold;
  font-size: 32rpx;
  color: #0DAE4E;
}

.success_tips .success_wait_text {
  margin-top: 16rpx;
  font-weight: 400;
  font-size: 28rpx;
  color: #666666;
}
.success_tips .back-btn {
  margin-top: 50rpx;
  background: #0DAE4E;
  font-size: 28rpx;
  width: 300rpx;

}

.van-uploader__preview .van-uploader__preview-image {
  width: 140rpx !important;
  height: 140rpx !important;
  background: #F7F7F7;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
  overflow:hidden;
}

.refund_btn.van-button--disabled {
  background: #ccc;
}

.price_box {
  margin: 0 24rpx 24rpx 24rpx;
  background: #FAFBFD;
  border-radius: 16rpx;
  overflow: hidden;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.price_box .van-cell {
  background-color: #FAFBFD !important;
  padding: 8rpx 24rpx !important;
  font-size: 28rpx;
  color: #333333;
  line-height: 46rpx;
  font-weight: 500;
}
.price_box .van-cell::after{
  border-bottom-width: 0 !important;
  
}

.price_tips {
  font-weight: 500;
  font-size: 24rpx;
  color: #ED4528;
  line-height: 46rpx;
  text-align: right;
  padding-right: 24rpx;
  padding-bottom: 8rpx;
}