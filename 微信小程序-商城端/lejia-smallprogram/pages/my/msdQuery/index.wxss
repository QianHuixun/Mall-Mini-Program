/* pages/my/pointQuery/index.wxss */
page {
    background: #f9f9f9;
  }
  
  .header-cell {
    position: relative;
    padding: 60rpx 80rpx;
    color: #09AF84;
    background: rgba(9, 175, 132, 0.1);
  }
  
  .header-cell .header-bg {
    z-index: -1;
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
  }
  
  .header-cell  .tips {
    font-size: 26rpx;
  }
  
  .header-cell .point {
    font-size: 72rpx;
    font-weight: bold;
  }
  
  .icon-cell {
    margin: 30rpx 65rpx;
    display: flex;
  }
  
  .icon-cell .icon-li {
    flex: 1;
    text-align: center;
    font-size: 24rpx;
  }
  
  .list-cell {
    margin: 30rpx 44rpx;
    background: #fff;
  }
  
  .new-active .van-ellipsis {
    color: #09AF84;
  }
  
  .list-li {
    display: flex;
    align-items: flex-end;
    padding: 35rpx 45rpx;
    border-bottom: 1px solid #f9f9f9;
  }
  
  .list-l {
    flex: 1;
  }
  
  .list-l_title {
    font-size: 28rpx;
  }
  
  .list-l_tips__date,
  .list-l_tips_code {
    font-size: 25rpx;
    line-height: 36rpx;
  }
  
  .list-r {
    font-size: 38rpx;
    text-align: end;
  }

  .balance {
    font-size: 25rpx;
    color: #333;
  }
  
  .list-r.plus {
    color: #09AF84;
  }
  
  .list-r.minus {
    color: #999;
  }


.recharge-popup {
  width: 520rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.recharge-popup-title {
  font-size: 30rpx;
  font-weight: bold;
}

.recharge-popup-content {
  width: 100%;
  margin-top: 24rpx;
}

.recharge-popup-conten_bar {
  display: flex;
  align-items: center;
}

.recharge-popup-conten_bar + .recharge-popup-conten_bar {
  margin-top: 24rpx;
}

.recharge-popup-conten_bar__label {
  padding: 0 12rpx;
  font-size: 30rpx;
}

.recharge-popup-botton {
  margin-top: 120rpx;
  display: flex;
  align-items: center;
}

.recharge-popup-botton__btn {
  margin:0 12rpx;
  width: 220rpx;
  height: 76rpx !important;
  background: #09AF84 !important;
  border-radius: 48rpx;
  font-weight: bold;
  font-size: 30rpx !important;
  color: #fff !important;
  border: 0 !important;
}

.recharge-popup-botton__btn.cancel {
  background: #FFFFFF !important;
  color: #000 !important;
  border: 1px solid #ccc !important;
}

.btn-confirm {
  width: 200rpx;
  height: 60rpx !important;
  background: #09AF84 !important;
  border-radius: 48rpx;
  font-weight: bold;
  font-size: 28rpx !important;
  color: #fff !important;
  border: 0 !important;
}

.flex {
  display: flex;
  align-items: center;
}

.flex .point {
  flex: 1;
}