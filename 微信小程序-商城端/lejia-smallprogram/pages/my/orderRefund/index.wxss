/* pages/my/orderRefund/index.wxss */
page {
  background: #f9f9f9;
}

.goods_cell {
  background: #fff;
  margin-bottom: 16rpx;
  padding-left: 20rpx;
}

.card_con {
  margin-right: 20rpx;
}

.card_goods_list {
  border-bottom: 1px solid #f9f9f9;
  padding: 10rpx 0;
  display: flex;
}

.card_goods_list .card_c,
.card_footer .card_l {
  flex: 1;
}

.card_goods_list .card_c {
  flex: 1;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.card_goods_list .card_r {
  font-size: 24rpx;
  text-align: right;
}

.card_goods_list .van-image {
  display: block;
  margin-right: 16rpx;
}


.descript_cell {
  margin-top: 16rpx; 
  padding-bottom: 20rpx;
  background: #fff;
}

.descript_cell .title {
  padding: 16rpx 30rpx;
  border-bottom: 1px solid #f9f9f9;
  font-size: 28rpx;
}

.descript_cell .title text {
  font-size: 24rpx;
}

#refund .new-field {
  color: #f22005;
}

.action_cell {
  padding: 10rpx 0;
}

.van-goods-action {
  height: 120rpx;
  padding: 0 30rpx;
}