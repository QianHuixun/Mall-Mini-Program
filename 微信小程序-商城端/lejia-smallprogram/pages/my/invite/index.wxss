#invite{
  background: #f2f2f2;
}
.top_img {
  width: 100%;
  height: auto;
  display: block;
}
.invite_btn-box{
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 ;
  background: #fff;
}
/* .invite_btn-box image {
  width: 80%;
} */
.invite_btn-box button{
  width: 600rpx;
  height: 100rpx;
  background: url('data:image/png;base64,');
background-size: 100%  100%;
}
.invite_btn-box button::after{
  border: 0 !important;
}
.invite_list {
  padding: 30rpx 15px 20rpx 15px;
  text-align: center;
  margin-bottom: 20px;
  background: #fff;
}

.invite_list-tit{
  display: block;
  position: relative;
  width: 100%;
  padding: 20rpx 0;
  margin-top: 20rpx;
  background: #fff;
  color: #1fca3e;
  font-size: 36rpx;
  font-weight: bold;
  text-emphasis: none;
  text-align: center;
}



.invite_list .list-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 90%;
  margin: 0 auto;
  margin-bottom: 20rpx;
}

.list-box .photo {
  height: 100rpx;
  width: 100rpx;
  border-radius: 50% !important;
  overflow: hidden;
  margin-right: 20rpx;
}

.list-box .photo image {
  height: 100%;
  width: 100%
}

.list-box .item-left {
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: left;
}

.item-left .invite_name {
  flex-direction: column;
  display: flex;
  padding: 10rpx 0;
}

.invite_name .label {
  font-size: 24rpx;
  color: #969696;
  margin-top: 10rpx;
}
.item-right{
  text-align: right;
  font-size: 28rpx;
  color: #333;
}
.item-right .price{
 font-size: 32rpx; 
 color: red;
}
.invite_empty-tips{
  text-align: center;
  color: #969696;
}
