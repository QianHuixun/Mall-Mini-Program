/* pages/my/supportApply/index.wxss */
page {
    background-color: #F2F4F7;
    font-size: 28rpx;
}

#supportApply {
    padding: 20rpx 24rpx 0;
    font-family: PingFang SC, PingFang SC;
    color: #333333;
}

.types-box {
    padding: 24rpx;
    height: 176rpx;
    background: #FFFFFF;
    border-radius: 24rpx;
}

.types-header {
    font-weight: bold;
    font-size: 28rpx;
}

.types-cell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 0 0;
}

.type-item {
    width: 314rpx;
    height: 80rpx;
    line-height: 80rpx;
    text-align: center;
    background: #F7F7F7;
    border: 2rpx solid #F7F7F7;
    border-radius: 40rpx;
    box-sizing: border-box;
    font-size: 28rpx;
}

.type-item.selected {
    background: rgba(9,175,132,0.05);
    border: 2rpx solid #09AF84;
    color: #09AF84;
}

.type-item + .type-item {
    margin-left: 24rpx;
}

.goods-box {
    padding: 24rpx;
    margin-top: 12rpx;
    background: #FFF;
    border-radius: 24rpx;
}

.goods-header {
    font-weight: bold;
    font-size: 28rpx;
}

.goods-item {
    display: flex;
    margin-top: 20rpx;
    overflow: hidden;
}

.goods-image {
    width: 120rpx;
    height: 120rpx;
    flex-shrink: 0;
    margin-right: 16rpx;
    background: #F5F5F5;
    border-radius: 16rpx;
    overflow: hidden;
}

.goods-content {
    flex: 1;
    overflow: hidden;
    position: relative;
}

.goods-title {
    height: 40rpx;
    line-height: 40rpx;
    font-weight: bold;
    font-size: 28rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.goods-spec {
    display: flex;
    height: 34rpx;
    line-height: 34rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #999999;
}

.goods-spec__count {
    margin-left: 16rpx;
}

.goods-tip { 
    height: 34rpx; 
    line-height: 34rpx; 
    margin-top: 12rpx; 
    font-size: 24rpx; 
    color: #ED4528; 
    overflow: hidden; 
    white-space: nowrap; 
    text-overflow: ellipsis; 
} 

.goods-counts {
    display: flex;
    position: absolute;
    bottom: 0;
    right: 12rpx;
}

.goods-counts__count {
    width: 24rpx;
    height: 64rpx;
    line-height: 64rpx;
    text-align: center;
    font-size: 24rpx;
}

.goods-counts .goods-counts__icon {
    width: 64rpx;
    height: 64rpx;
}

.footer {
    position: fixed;
    z-index: 1000;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 168rpx;
    box-sizing: border-box;
    padding: 20rpx 24rpx;
    background: #fff;
    border-top: 1px solid #f9f9f9;
    text-align: right;
}

.footer .footer-btn {
    height: 76rpx;
    background: #09AF84;
    font-weight: bold;
    font-size: 30rpx;
    color: #FFFFFF;
}