/* pages/pay/result/index.wxss */
#result .xcx-image {
  display: block;
  margin: 80rpx auto 56rpx auto;
}

.title {
  margin-bottom: 100rpx;
  font-size: 40rpx;
  text-align: center;
}

.button-cell {
  width: 100%;
  padding: 0 76rpx;
  box-sizing: border-box;
}

.button-cell .lj-button {
    width: 100%;
    height: 70rpx;
    margin-bottom: 24rpx;
}

.popon {
  z-index: 100;
  display: flex;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.popon .cover {
  z-index: -1;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba( 0, 0, 0, .5);
}

.popon .content {
  position: relative;
  margin: 0 50rpx;
  padding: 12rpx 55rpx;
  width: calc( 100% - 100rpx );
  border-radius: 18rpx;
  background: #fff;
  text-align: center;
}

.popon .content image {
  width: 100%;
  margin-bottom: 50rpx;
}

.popon .content .title,
.popon .content .descript {
  text-align: center;
}

.popon .content .title {
  margin-bottom: 0;
  color: #f73c17;
  font-size: 34rpx;
  line-height: 60rpx;
}

.popon .content .descript { 
  font-size: 24rpx;
  color: #999;
}

.popon .content .descript text {
  font-size: 40rpx;
  color: #f22005;
}

.popon .content .van-button {
  margin: 45rpx auto;
}

.popon .content .van-icon {
  z-index: 1;
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}