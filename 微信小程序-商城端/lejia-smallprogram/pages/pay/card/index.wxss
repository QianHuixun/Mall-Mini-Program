/* pages/my/card1/index.wxss */
#card {
    display: flex;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    flex-direction: column;
    background-color: #f2f4f7;
}

#card .card-tabs .van-tabs__wrap {
    height: 80rpx;
}

#card .card-tabs .van-tabs__wrap .van-tabs__nav--line {
    height: 80rpx;
}

#card .card-tabs .van-tab {
    font-size: 14px;
    line-height: 14px;
    padding-top: 26rpx;
    font-family: PingFang SC;
    font-weight: 500;
    color: #333333;
}

#card .card-tabs .van-tab--active {
    font-family: PingFang SC;
    font-weight: bold;
    color: #0DAE4E;
}

#card .card-tabs .van-tabs__line {
    width: 64rpx;
    height: 6rpx;
    background: #0DAE4E;
    border-radius: 4rpx;
}

/* end tab样式修改 */
#card .scroll-view-box {
    height: 100vh;
    width: 100vw;
}
#card .scroll-view-box .scroll-view{
    height: 100vh;
    width: 100vw;
    box-sizing: border-box;
    overflow-y: scroll;
    padding-bottom: 260rpx;
}

#card .scroll-view .nodata-back {
    width: 100%;
    height: 100%;
    padding-top: 224rpx;
    text-align: center;
    font-size: 26rpx;
    font-family: PingFang SC;
    font-weight: 500;
    color: #BDBDBD;
    line-height: 26rpx;
}

#card .scroll-view .nodata-back image {
    width: 184rpx;
    height: 184rpx;
    margin-bottom: 40rpx;
}

#card .scroll-view .card-item {
    width: 702rpx;
    background: #FFFFFF;
    border-radius: 24rpx;
    padding: 24rpx;
    margin: 20rpx 24rpx 0 24rpx;
    box-sizing: border-box;

}



#card .scroll-view .card-box {
    display: flex;
}

#card .scroll-view .card-box .card-price {
    width: 190rpx;
    height: 152rpx;
    background: linear-gradient(90deg, #FF9E1D, #FDB32F);
    border-radius: 16rpx;
    padding-top: 32rpx;
    margin-right: 24rpx;
    box-sizing: border-box;
}

#card .scroll-view .disabled .card-box .card-price {
    background: #D9D9D9;
}

.card-box .card-price .card-price-title {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 24rpx;
}

.card-box .card-price .card-price-title .unit {
    font-size: 32rpx;
    line-height: 32rpx;

    font-family: PingFang SC;
    font-weight: bold;
    color: #FFFFFF;
}

.card-box .card-price .card-price-title view {
    display: inline-block;
    font-size: 56rpx;
    font-family: PingFang SC;
    font-weight: bold;
    color: #FFFFFF;
    line-height: 46rpx;
}

.card-box .card-price .card-price-label {
    font-size: 22rpx;
    font-family: PingFang SC;
    font-weight: 500;
    color: #FFFFFF;
    text-align: center;
}

.card-box .card-info {
    flex: 1;
    width: 0;
}

.card-box .card-info .card-title {
    padding-top: 8rpx;
    padding-bottom: 24rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 30rpx;
    font-family: PingFang SC;
    font-weight: bold;
    color: #333333;
    line-height: 30rpx;
}

.card-box .card-info .card-time {
    font-size: 24rpx;
    line-height: 24rpx;
    font-family: PingFang SC;
    font-weight: 500;
    color: #999999;
    padding-bottom: 22rpx;
}

.card-box .card-info .card-rule {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-box .card-info .card-rule .card-rule-title {
    display: flex;
    align-items: center;
}

.card-box .card-info .card-rule .card-rule-title text {
    display: inline-block;
    line-height: 24rpx;
    font-size: 24rpx;
    font-family: PingFang SC;
    font-weight: 500;
    color: #999999;
    padding-right: 12rpx;
}

.card-box .card-info .card-rule .card-rule-title .van-icon {
    color: #999999;
    transition: transform 0.3s
}

.card-box .card-info .card-rule .card-rule-title .rule {
    transform: rotate(180deg);
}

.card-box .card-info .card-rule .card-button {
    width: 120rpx;
    height: 48rpx;
    background: #FFFFFF;
    border: 2rpx solid #63BF57;
    border-radius: 24rpx;
    font-size: 22rpx;
    font-family: PingFang SC;
    font-weight: bold;
    color: #63BF57;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0
}

.card-item .card-rule-box {

    height: 0;
    overflow: hidden;
    box-sizing: border-box;
    transition: height 0.3s ease-in-out;
}

.card-item .card-rule-box view {
    font-size: 24rpx;
    line-height: 26rpx;
    font-family: PingFang SC;
    font-weight: 500;
    color: #999999;

}

.card-item .card-rule-box view+view {
    margin-top: 10rpx;
}

.card-item .card-rule-box view:first-child {
    padding-top: 24rpx;
}

.card-item .card-rule-box.not-collapse {
    height: fit-content;
}
.card-box .card-noactive{
  display: flex;
  align-items: center;
}
.card-box  .card-noactive image {
    width: 94rpx;
    height: 94rpx;
}
 .card-invalid  .card-info .card-title{
color: #999999;
}   
#card .scroll-view .card-invalid  .card-price {
    background: linear-gradient(90deg, #B8B8B8, #CECECE);
}

.card-item .unusable-tips {
    display: flex;
    align-items: center;
    min-height: 68rpx;
    line-height: 34rpx;
    margin-top: 12rpx;
    margin-left: -24rpx;
    margin-right: -24rpx;
    margin-bottom: -24rpx;
    padding: 0 24rpx;
    font-size: 24rpx;
    color: #FF8A00;
    background: #FEF8EA;
}

.footer-bottom {
    position: fixed;
    bottom: 0;
    right: 0;
    left: 0;
    padding: 24rpx;
    padding-bottom: 48rpx;
    background: #FFFFFF;
}