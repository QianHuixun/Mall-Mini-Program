/* pages/pay/pay/index.wxss */
page {
  background: #f6f6f6;
}

#pay {
  position: relative;
  padding-bottom: 16rpx;
}

#pay .pay-navbar {
  background: #19cf51;
}

.pay-navbar::after {
  border-bottom-width: 0px !important;
}

#pay .van-nav-box {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
}

#pay .pay-navbar .van-nav-bar__title,
#pay .pay-navbar .van-nav-bar__left .van-icon {
  color: #fff !important;
}

#pay .pay-navbar .van-nav-bar__content::after {
  border-bottom-width: 0px;
}

#pay .top-back {
  position: fixed;
  height: 420rpx;
  width: 100vw;
  top: 0px;
  left: 0;
  right: 0;
  z-index: -1;
}

#pay .top-back image {
  width: 100%;
  height: 100%;
}

.new-popup {
  position: relative;
  border-top-left-radius: 60rpx;
  border-top-right-radius: 60rpx;
  overflow: hidden;
}

.new-popup .title {
  z-index: 1;
  position: absolute;
  text-align: center;
  width: 70%;
  left: 15%;
  height: 88rpx;
  line-height: 88rpx;
}

/* 新地址开始 */
.addr {
  width: 100%;
  /* height: 382rpx; */
  display: flex;
  flex-direction: column;
  background: transparent;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  padding-top: 20rpx;
  box-sizing: border-box;

}

.addr .addr_tabs {
  height: 92rpx;
  position: relative;
}

.addr_tabs_con {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
}

.addr_tabs_con>view {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.addr_tabs_img {
  position: absolute;
  width: 100%;
  height: 92rpx;
}

.addr_tabs_bg {
  width: 100%;
  height: 78rpx;
  background: #eeeeee;
  border-radius: 5px 5px 0 0;
  position: absolute;
  bottom: 0;
}

.addr_con {
  flex: 1;
  background: #fff;
  display: flex;
  border-radius: 0px 0px 24rpx 24rpx;
}

.addr_con .right_arrw {
  width: 9rpx;
  height: 16rpx;
}

.addr_container {
  flex: 1;
  background: #fff;
}

.addr_tabs {
  width: 100%;
}


#pay>.addr_con {
  margin: 0 24rpx;
  border-radius: 24rpx;
  padding: 10px 0;
  margin-bottom: 10px;
}

.addr_con {
  position: relative;
  margin-bottom: 10rpx;
  box-sizing: border-box;
}

.addr_con>view {
  width: 100%;
}

.choose_addr {
  /* width: 100%; */
  height: 102rpx;
  /* padding: 0 24rpx; */
  margin: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-bottom: 1px solid #F0F0F0;
}

.choose_hasaddr {
  display: block;
  margin: 0 24rpx;
  box-sizing: border-box;
  border-bottom: 1px solid #F0F0F0;
}

.choose_addr_title {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 0;
  font-size: 32rpx;
  font-weight: bold;
}

.addr_contact {
  font-size: 26rpx;
  color: #999999;
  padding-bottom: 32rpx;
}

.addr_contact>span {
  margin-right: 26rpx;
}

.choose_addr>span {
  font-size: 32rpx;
  font-weight: bold;
}

.choose_addr>image {
  width: 9rpx;
  height: 16rpx;
}

.choose_time {
  display: flex;
  align-items: center;
  height: 97rpx;
  justify-content: space-between;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.choose_time_con {
  color: #0DAE4E;
  font-weight: bold;

}

.choose_time_con .choose_time_tips {
  padding-right: 10rpx;

}

.choose_time_time {
  margin: 0 24rpx 0 18rpx;
}

.choose_time_con>image {
  width: 9rpx;
  height: 16rpx;
}

.addr_con_ts {
  display: flex;
  background: #fff;
  padding: 60rpx 24rpx;
  line-height: 48rpx;
  font-size: 28rpx;
  border-radius: 0rpx 0rpx 24rpx 24rpx;
}

.addr_con_ts .left {
  margin-right: 16rpx;
}

.addr_con_ts .right {
  flex: 1;
  font-weight: bold;
  font-size: 48rpx;
  color: #0DAE4E;
}

.addr_con_zt {
  padding: 39rpx 24rpx 9rpx;
}
.addr_con_zt .zt_time {
  display: block;
}
.addr_con_gift{
  padding: 0rpx 24rpx 0rpx;
}
.addr_con_gift .zt_time{
  padding: 16rpx 0;
}
.zt_addr {
  padding-bottom: 34rpx;
  border-bottom: 1px solid #f0f0f0;
}

.zt_addr_name {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
}

.zt_addr_name image {
  width: 30rpx;
  height: 30rpx;
  margin-right: 13rpx;
}

.zt_addr_desc {
  font-size: 26rpx;
  color: #999999;
  margin-top: 23rpx;
}

.zt_addr_open {
  font-size: 26rpx;
  color: #999999;
  margin-top: 15rpx;
}

.zt_time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 32rpx 0;
}

.zt_time_item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.zt_time_item:first-child {
  margin-bottom: 10rpx;
}

.zt_time_time {
  color: #0DAE4E;
}

.zt_time image {
  width: 9rpx;
  height: 16rpx;
  margin-left: 26rpx;
}

/* 新地址设置结束 */

.addr_con .addr_content {
  position: absolute;
  top: 0;
  right: 0;
  width: calc(100% - 85px);
  height: 100%;
  background-color: #fff;
  padding: 16rpx 24rpx 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.addr_con .addr_choose {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

.addr_con .van-cell-text {
  display: flex;
}

.van-cell-text .name {
  flex: 1;
}

.addr_img {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
}

.goods_group {
  border-radius: 10rpx;
  margin: 0 24rpx;
}

.goods_group .new-card {
  background: #fff;
  padding: 32rpx 30rpx 0 24rpx;
}

#pay .new-cell-group::after {
  border: none;

}

#pay .new-cell {
  align-items: center;
  height: 130rpx;
  background-color: transparent !important;
}

#pay .new-cell::after {
  border: none;

}

#pay .new-cell.border-bottom::after {
  border-bottom: 1px #F0F0F0 solid;
  border-bottom-color: #F0F0F0;
  transform: scaley(1);
}

#pay .new-cell .van-icon {
  font-size: 48rpx;
}

#pay .time-cell {
  margin-bottom: 10rpx;
}

.goods_group {
  background: #fff;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  padding-bottom: 32rpx;
}

.goods_group .title {
  padding: 24rpx 0 0 24rpx;
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.goods_group .footer {
  display: flex;
  padding: 20rpx 30rpx;
  font-size: 26rpx;
}

.goods_group .footer .footer_l {
  flex: 1;
}

.price_cell {
  background: #fff;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  border-radius: 24rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;

}



.price_group .item {
  display: flex;
  margin: 0 24rpx 0 24rpx;
  padding: 30rpx 0 32rpx 0;

  align-items: center;
  box-sizing: border-box;
  border-bottom: 2rpx solid #F0F0F0;
}

.price_group .item .item_l {
  flex: 1;
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #333333;
  line-height: 28rpx;
}

.price_group .item .item_r {
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
  line-height: 30rpx;
}

.price_group .item .strikeout {
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: 500;
  text-decoration: line-through;
  color: #999999;
  padding-right: 24rpx;
}

.price_cell .footer {
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 32rpx 24rpx;
  font-size: 24rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #333333;
}
.price_cell .footer .footer-price{
  display: inline-block;
  font-size: 32rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #ED4528;
  padding-left: 16rpx;
  line-height: 32rpx;
}
.price_cell .footer .unit {
  display: inline-block;
  padding-right: 10rpx;
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #ED4528;
  line-height: 30rpx;
  
}

.price_group .new_icon {
  display: block;
  margin-left: 20rpx;
}

.paytype_cell {
  background: #fff;
  margin-right: 24rpx;
  margin-left: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}


#pay .paytype_cell .new-cell .van-icon {
  font-size: 80rpx;
}

.goods_group .new-card .van-card__img {
  border-radius: 16rpx;
}

.goods_group .new-card .van-card__thumb {
  height: 140rpx;
  width: 140rpx;
}

.goods_group .new-card .van-card__content {
  min-height: 120rpx;
}

.goods_group .new-card .van-card__title {
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
  line-height: 30rpx;
  padding-bottom: 14rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;

}

.goods_group .new-card .van-card__desc {
  font-size: 22rpx;
  line-height: 22rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;
  padding-bottom: 36rpx;
}

.goods_group .new-card .van-card__price text {
  font-size: 24rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
}

.goods_group .new-card .van-card__price text:first-child {
  padding-right: 6rpx;
}

.goods_group .new-card .van-card__price .van-card__price-integer {
  font-size: 32rpx;
}

.goods_group .new-card .van-card__num {
  font-size: 24rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;
}

.card_group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx 0 24rpx;
}

.space-image-box {
  display: flex;
  overflow: hidden;
  width: 490rpx;
}

.space-image {
  width: 90rpx;
  height: 90rpx;
}

.space-image+.space-image {
  margin-left: 10rpx;
}

.space-image image {
  width: 100%;
  height: 100%;
}

.space-image-num {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;
}

.remark_cell {
  margin-bottom: 20rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
}

.remark_cell .title {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #333333;
  line-height: 28rpx;
}

.remark_cell .tips {

  font-size: 28rpx;
  line-height: 32rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: flex-end;

}

.tips view {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  width: 500rpx;
  text-align: right;
}

.remark_cell .tips image {
  width: 24rpx;
  height: 24rpx;
  margin-left: 18rpx;
}

.remark_input {
  min-height: 150rpx !important;
  padding: 10rpx 20rpx !important;
  border-radius: 10rpx !important;
  background: #f6f6f6 !important;
}

.addr_con .van-sidebar-item {
  padding: 10px 12px 10px 8px;
}

.abholungtime_titile {
  text-align: center;
  line-height: 30px;
  height: 30px;
}

.abholungtime_subTitile {
  height: 32px;
  line-height: 32px;
  font-size: 26rpx;
  color: #0DAE4E;
  text-align: center;
  background: #EFFFF5;
}

.space-pop {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 330px;
}

.space-pop-box {
  flex: 1;
  overflow-y: scroll;
}

.space-pop-box .goods_group {
  padding-bottom: 0;

}

.space-pop-title {
  text-align: center;
  width: 100%;
  padding: 16rpx;
  border-bottom: 2rpx solid #F0F0F0;
  box-sizing: border-box;
}

.spaces-card-box .new-card .new-card-price {
  display: inline-flex;
  align-items: center;
  background: #F7F7F7;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-family: PingFang SC;
  color: #333333;
  padding: 10rpx 16rpx 10rpx 12rpx;
  line-height: 26rpx;
}

.spaces-card-box .new-card .new-card-price text {
  font-size: 26rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #333333;
  line-height: 26rpx;
}

.spaces-card-box .space-card .van-card__thumb {
  width: 90rpx;
  height: 90rpx;
}

.spaces-card-box .space-card {
  padding: 32rpx 30rpx 0 74rpx;
}

.spaces-card-box .space-card .van-card__content {

  min-height: 90rpx;
}

.spaces-card-box .space-card .van-card__title {
  font-size: 22rpx;
  line-height: 22rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;

}

.van-field {
  background: #f6f6f6 !important;
}

.btn-box {
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn {
  border-radius: 38px 0px 0px 38px !important;
  height: 70rpx !important;
  padding: 0 80rpx !important;
}

.cancel-btn {
  border-radius: 0px 38px 38px 0px !important;
  height: 70rpx !important;
  padding: 0 80rpx !important;
}

.no-card {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999999;
}

.card-price {
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: bold;
  color: #ED4528;
}

/**会员价格与原价*/
.price-mermber {
  flex: 1;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #4dce78;
}

.price-mermber .price-mermber-txt {
  display: inline-block;
  margin-right: 16rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #885F1A;
}

.price-mermber .price-mermber-txt .unit {

  font-size: 24rpx;
  font-weight: bold;
  padding-right: 6rpx;
}

.price-mermber-tag {
  width: 86rpx;
  height: 26rpx;
}

#van-dialog .van-dialog__header {
  font-weight: bold !important;
  font-size: 34rpx !important;
  color: #333333 !important;
  padding-top: 32rpx !important;
  padding-bottom: 40rpx !important; 
}

#van-dialog .van-dialog__message {
  font-size: 30rpx !important;
  color: #333333 !important;
  line-height: 46rpx !important;
  padding-top: 0 !important;
  padding-bottom: 64rpx !important;
}

#van-dialog .van-goods-action  {
  padding: 0 24rpx 40rpx 24rpx !important;
}

#van-dialog .van-dialog__button .van-button--danger {
  width: 262rpx;
  height: 76rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  font-weight: bold;
  font-size: 26rpx;
  color: #333333;
  border: 1px solid #CCCCCC;
}

#van-dialog .van-goods-action {
  height: 76rpx;
}

#van-dialog .van-goods-action-button {
  margin: 0;
}

#van-dialog .van-goods-action-button--first .van-button--danger {
  margin-right: 9rpx;
}

#van-dialog .van-goods-action-button--last .van-button--danger {
  background: #0DAE4E;
  color: #fff;
  border-color: #0DAE4E;
  margin-left: 9rpx;
}

#van-dialog .van-popup--center {
  width: 590rpx;
}

.item_l_tips {
  font-size: 24rpx;
  color: #999999;
}

.item_r_del {
  font-size: 24rpx;
  color: #999999;
  text-decoration: line-through;
}