/* pages/merMien/merchantDetail/index..wxss */

#merchant-detail video {
  width: 100%;
  height: 184px;
}

#merchant-detail swiper {
  width: 100%;
  height: 184px;
}

.detail-main {
  padding-top: 54rpx;
  background: #488142;
}

.detail-main-box {
  background: #fff;
  border-top-right-radius: 32rpx;
  border-top-left-radius: 32rpx;
  height: 300px;
  position: relative;
  padding-top: 10px;
}

.detail-main-box .van-image__img {
  border-radius: 16rpx;
}

.detail-main-box .row-logo {
  position: absolute;
  top: -16px;
  left: 10px;
}

.row-inrto {
  padding-left: 90px;
  display: flex;
  padding-right: 10px;
}

.row-tag {
  white-space: nowrap;
  overflow-x: scroll;
  flex: 1;
}

/*隐藏滚动条*/
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.row-tag .van-notice-bar {
  background: transparent !important;
}

.row-tag .van-tag {
  margin-right: 10px;

}

.row-inrto .row-name {
  padding-right: 10px;
}

.row-detail {
  padding-top: 50px;
  padding: 50px 10px 0px 10px;
  overflow: hidden;
}

.row-inrto .van-tag {
  color: #bfbfbf;
}

.swiper-container {
  position: relative;
}

.page-view {
  display: flex;
  align-items: center;
  position: absolute;
  height: 48rpx;
  right: 10rpx;
  bottom: 30rpx;
  padding: 0 20rpx 5rpx 20rpx;
  border-radius: 27rpx;
  color: white;
  background: rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
}

.page-num {
  font-size: 26rpx;
}

.page-total-num {
  font-size: 26rpx;
}

.sound-view {
  display: flex;
  align-items: baseline;
  position: absolute;
  height: 48rpx;
  right: 10rpx;
  bottom: 90rpx;
  padding: 0 30rpx 5rpx 30rpx;
  border-radius: 27rpx;

  color: white;
  background: rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
}

rich-text .rich-img {
  max-width: 100%;
  height: auto;
}