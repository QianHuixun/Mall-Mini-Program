/* custom-tab-bar/index.wxss */
.tab-bar {
    position: relative;
    /* height: 186rpx; */
    display: flex;
    align-items: center;
    justify-content: center;
}

.tab-bar-content {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-around;
    position: relative;
    bottom: 50rpx;
    z-index: 1;
}

.tab-bar-content>view {
    display: flex;
    align-items: center;
}

.content-right,
.content-left {
    width: 295rpx;
    display: flex;
    align-items: center;
    justify-content: space-around;
}

.content-center-classification {
    width: 160rpx;
    height: 160rpx;
    margin-top: -85rpx;
}

.tab-bar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.item-icon {
    width: 64rpx;
    height: 64rpx;
}

.item-name {
    font-family: PingFangSC, PingFang SC;
    font-weight: 500;
    font-size: 20rpx;
    color: #999999;
}

.active .item-name {
    color: #09AF84;
}

.tab-bar-bg {
    position: absolute;
    bottom: 50rpx;
    right: 0;
    left: 0;
    width: 100%;
    height: 92rpx;
}

.tab-bar-bottom {
    background: #FFFFFF;
    position: absolute;
    bottom: 0;
    right: 0;
    left: 0;
    width: 100%;
    height: 60rpx;
}