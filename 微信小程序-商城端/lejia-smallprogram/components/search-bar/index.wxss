/* components/search-bar/index.wxss */
.search-bar-container {
    box-sizing: border-box;
    width: 100%;
    height: 64rpx;
    background: transparent;
    display: flex;
    align-items: center;
}

.search-bar-container .search-tips {
    font-size: 24rpx;
    line-height: 24rpx;
    font-weight: 500;
    color: #999999;
    margin-left: 12rpx;
}

.search-bar-container .search-tips-scroll {
    width: 100%;
    height: 64rpx;
}

.search-bar-container .search-tips-scroll-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.search-bar-container .search-tips-scroll-item {
    width: 100%;
    height: 100%;
    line-height: 64rpx;
}