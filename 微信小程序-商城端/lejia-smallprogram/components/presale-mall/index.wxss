/* components/presale-mall/index.wxss */
.points-mall {
  box-sizing: border-box;
  margin: 20rpx 24rpx 0rpx 24rpx;
  padding: 16rpx 26rpx 10rpx 24rpx;
  height: 450rpx;
  position: relative;
}

.points-mall .points-mall-back {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.points-mall .points-mall-title {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 5rpx;
}

.points-mall .title-left {
  font-size: 32rpx;
  font-weight: bold;
  color: #A56D41;
}

.points-mall .title-right {
  font-size: 24rpx;
  color: #A56D41;
  display: flex;
  align-items: center;
}

.points-mall .title-right van-icon {
  margin-left: 16rpx;
}

.points-mall .points-mall-box {
  margin-top: 24rpx;
  position: relative;
}

.points-mall .points-mall-box .points-mall-container {
  overflow-x: scroll;
  white-space: nowrap;
}

.points-mall .points-mall-box .points-mall-container::-webkit-scrollbar {
  display: none;
}

.points-mall .points-mall-box .points-mall-box-item+.points-mall-box-item {
  margin-left: 8rpx;
}

.points-mall .points-mall-box .points-mall-box-item {
  box-sizing: border-box;
  /* position: relative; */
  width: 208rpx;
  height: 344rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.points-mall .points-mall-box .points-mall-box-item .points-mall-box-image {
  width: 192rpx;
  height: 192rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.points-mall .points-mall-box .points-mall-box-item .points-mall-box-image .images {
  width: 100%;
  height: 100%;
}

.points-mall .points-mall-box .points-mall-box-item .item-title {
  margin-top: 16rpx;
  color: #333333;
  width: 100%;
  font-weight: bold;
  font-size: 26rpx;
  display: -webkit-box;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.points-mall .points-mall-box .points-mall-box-item .item-desc{
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-top: 8rpx;
}

.points-mall .points-mall-box .points-mall-box-item .item-desc .num-view{
  display: flex;
  width: 100%;
  flex-direction: column;
}

.points-mall .points-mall-box .points-mall-box-item .item-desc .num-view .points{
  color: #A56D41;
  font-size: 24rpx;
  font-weight: bold;
}

.points-mall .points-mall-box .points-mall-box-item .item-desc .num-view .price{
  color: #A56D41;
  font-size: 28rpx;
  font-weight: bold;
}

.points-mall .points-mall-box .points-mall-box-item .item-desc .num-view .num-ori{
  color: #999999;
  font-size: 20rpx;
  text-decoration: line-through;
}