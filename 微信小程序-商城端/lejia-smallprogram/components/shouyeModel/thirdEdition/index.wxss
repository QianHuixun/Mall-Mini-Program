/* components/shouyeModel/thirdEdition/index.wxss */
page {
    background: #F3F5F8;
}

.scroll-view {
    width: 100vw;
    height: 100vh;
    padding-bottom: 200rpx;
}

/* 导航栏START */
.navbar-back {
    position: fixed;
    top: 0;
    width: 100%;
    padding-bottom: 4rpx;
    z-index: 1;
}

.nav-content {
    position: relative;
    display: flex;
    align-items: center;
    height: 80rpx;
    padding: 0 12rpx;
}

.nav-content>image {
    position: absolute;
    z-index: 0;
    width: 100%;
    height: 88rpx;
    bottom: 0;
    top: 0;
}

.nav {
    width: 452rpx;
    height: 58rpx;
    display: flex;
    align-items: center;
    z-index: 10;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 35rpx;
}

.nav-left,
.nav-right {
    width: 24rpx;
    height: 24rpx;
    color: #fff;
    margin-left: 12rpx;
    margin-right: 12rpx;
}

.nav-left image {
    display: block;
}

.nav-market_name {
    flex: 1;
    font-family: PingFangSC, PingFang SC;
    font-weight: 600;
    font-size: 26rpx;
    color: #FFFFFF;
    line-height: 36rpx;
    text-align: left;
    font-style: normal;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.search-bar {
    padding: 0 24rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border-top-left-radius: 24rpx;
    border-top-right-radius: 24rpx;
    z-index: 10;
    position: relative;
}

.search {
    width: 58rpx;
    height: 58rpx;
    margin-left: 16rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 29rpx;
}

/* 导航栏END */

/* 广告轮播图START */
.swiper-container {
    height: 692rpx;
}
.ads-swiper {
    background-color: transparent;
    height: 692rpx;
}

.swiper .swiper-item .swiper-item-image {
    width: 100%;
    height: 100%;
}

/* 广告轮播图END */

/* 分类START */
.class {
    position: relative;
    top: -35rpx;
    padding-top: 30rpx;
    border-radius: 30rpx 30rpx 0rpx 0rpx;
    background-color: #F3F5F8;
}

.delivery-time {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    top: -8rpx;
    font-size: 30rpx;
    color: #08BB8D;
}

/* 分类END */

/* 组合广告START */
.combo-adv {
    display: flex;
    margin: 20rpx 26rpx 0;
}

.combo-adv-left {
    width: 340rpx;
    height: 448rpx;
    border-radius: 30rpx;
    overflow: hidden;
}

.combo-adv-right {
    margin-left: 16rpx;
}

.combo-adv-right-top {
    width: 342rpx;
    height: 216rpx;
    border-radius: 30rpx;
     overflow: hidden;
}

.combo-adv-right-bottom {
    margin-top: 18rpx;
    display: flex;
}

.combo-adv-right-bottom-left {
    width: 160rpx;
    height: 216rpx;
    border-radius: 30rpx;
     overflow: hidden;
}

.combo-adv-right-bottom-right {
    width: 160rpx;
    height: 216rpx;
    margin-left: 22rpx;
    border-radius: 30rpx;
     overflow: hidden;
}

.combo-adv .swiper {
    width: 100%;
    height: 100%;
}

/* 组合广告END */

/* 今日推荐END */
.today-recommend {
    margin: 28rpx 25rpx;
}

.today-recommend-title {
    display: flex;
    align-items: flex-end;
}

.today-recommend-title .main-title {
    width: 144rpx;
    height: 34rpx;
}

.today-recommend-title .sub-title {
    width: 156rpx;
    height: 30rpx;
    margin-left: 6rpx;
}

.recommend-goods {
    margin: 24rpx -24rpx;
}

/* 今日推荐END */