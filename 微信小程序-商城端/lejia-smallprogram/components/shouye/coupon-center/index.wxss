/* components/shouye/coupon-center/coupon-center.wxss */
.coupon {
    box-sizing: border-box;
    margin: 20rpx 24rpx 0rpx 24rpx;
    padding: 16rpx 26rpx 10rpx 24rpx;
    height: 244rpx;
    position: relative;
    background-image: linear-gradient(179deg, #FFE6E4 0%, #FFF4F3 56%, #FFFFFF 100%);
    border-radius: 28rpx;
}

.coupon .coupon-title {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 5rpx;
}

.coupon .title-left {
    font-size: 32rpx;
    font-family: 黑体;
    font-weight: bold;
    font-size: 32rpx;
    font-style: italic;
    color: #333333;
}

.coupon .title-right {
    font-size: 26rpx;
    font-weight: 500;
    color: #666666;
    display: flex;
    align-items: center;
}

.coupon .title-right van-icon {
    margin-left: 8rpx;
}

.coupon .coupon-box {
    margin-top: 24rpx;
    position: relative;
}

.coupon .coupon-box .coupon-container {
    overflow-x: scroll;
    white-space: nowrap;
    width: 100%;
}

.coupon .coupon-box .coupon-btn {
    position: absolute;
    top: 8rpx;
    right: -20rpx;
    width: 132rpx;
    height: 132rpx;
    z-index: 3;
}

.coupon .coupon-box .coupon-unactive-btn {
    top: 10rpx;
    right: -8rpx;
    width: 112rpx;
    height: 112rpx;
}

.coupon .coupon-box .coupon-item-more {
    position: absolute;
    top: 0rpx;
    right: -10rpx;
    width: 122rpx;
    height: 132rpx;
}

.coupon .coupon-box .coupon-box-item+.coupon-box-item {
    margin-left: 12rpx;
}

.coupon .coupon-box .coupon-box-item {
    position: relative;
    width: 122rpx;
    height: 132rpx;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    vertical-align: top;
}

.coupon .coupon-box .coupon-box-item .item-back,
.coupon .coupon-box .coupon-box-item .item-back-unactive {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    font-weight: 500;
    color: #FFFFFF;
}

.coupon .coupon-box .coupon-box-item .item-back-unactive {
    z-index: 3;
}

.coupon .coupon-box .coupon-box-item .item-cost {
    padding-top: 16rpx;
    font-weight: 800;
    color: #ED4528;
    font-size: 50rpx;
    position: relative;
    z-index: 1;
}

.coupon .coupon-box .coupon-box-item .item-cost text {
    font-size: 24rpx;
}

.coupon .coupon-box .coupon-box-item .item-limitcost {
    position: relative;
    z-index: 1;
    font-size: 20rpx;
    font-weight: 500;
    color: #FF6449;
    padding-bottom: 12rpx;
}