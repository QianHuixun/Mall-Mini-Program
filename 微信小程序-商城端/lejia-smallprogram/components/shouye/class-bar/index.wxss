/* components/shouye/class-bar/index.wxss */
.class-bar {
  margin: 12rpx 24rpx;
}
.top-class {
  display: flex;
  flex-wrap: wrap;
}
.top-class-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 12rpx;
}
.top-class-item .item-icon {
  width: 100rpx;
  height: 100rpx;
  background-color: transparent;
}
.top-class-item .item-name {
  width: 120rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: clip;
}
.bottom-class {
  display: flex;
  margin-top: 16rpx;
  padding: 0 4px;
  overflow-x: scroll;
}
.bottom-class-item {
  width: 18%;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 12rpx;
}
.bottom-class-item .item-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: transparent;
}
.bottom-class-item .item-name {
  width: 120rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: clip;
}
.van-image {
    width: 100%;
    height: 100%;
}
