<!-- 
@url: pages/cancelRecord/index.wxml
@description:卡券核销记录查询
@author: crj
@date: 2022-03-10
 -->
<view class="order">
  <van-tabs active="{{ active }}" color="#0066cc" title-active-color="#0066cc" title-inactive-color="#797979" bind:change="onChange">
    <van-tab title="待核销">
      <view class="order_item_container">
        <view class="order-detial_panel" wx:for="{{dataList}}" wx:key="index">
          <view class="panel_top">订单号：{{item.code}}</view>
          <view class="panel_middle">
            <view>商品名称：{{item.goodsName}}</view>
            <view>规格：{{item.spaceName||'--'}}</view>
            <!-- <view>下单时间：{{item.createdTime}}</view> -->
          </view>
          <view class="panel_middle">
            <view>订单金额：￥{{item.amtn}}</view>
            <view>数量：{{item.num}}</view>
          </view>
          <view class="panel_middle">
            <view class="panel_remark">备注：{{item.remark!=null?item.remark:'无'}}</view>
          </view>
          <view class="panel_bottom">
            <view >下单时间：{{item.createdTime}}</view>
         
          </view> 
        </view>
        <!-- <load-more id="loadMoreView" bindloadMoreListener='loadMoreListener' bindclickLoadMore='clickLoadMore'></load-more> -->
      </view>
    </van-tab>
    <van-tab title="已核销">
      <view class="top-atm_container">
        <view class="top-atm_container_item">
          <view class="tag">总计金额</view>
          <view class="num">{{sumData}}<text class="unit">元</text></view>
        </view>
      </view>
      <view class="order-detial">
        <van-cell custom-class="order-van_cell">
          <view slot="title" class="van-cell_custom">
            <view>
              <text class="van-cell_title__line"></text>
              <text>订单明细</text>
            </view>
            <view bindtap="showPopup">
              <!-- <image src="/images/筛选.png" alt=""></image> -->
              <van-image width="28rpx" height="28rpx" src="/images/筛选.png" />
            </view>
          </view>
        </van-cell>
        <view class="order-detial_panel" wx:for="{{dataList}}" wx:key="index">
          <view class="panel_top">订单号：{{item.code}}</view>
          <view class="panel_middle">
            <view>商品名称：{{item.goodsName}}</view>
            <view>规格：{{item.spaceName||'--'}}</view>
            <!-- <view>下单时间：{{item.createdTime}}</view> -->
          </view>
          <view class="panel_middle">
            <view>订单金额：￥{{item.amtn}}</view>
            <view>数量：{{item.num}}</view>
          </view>
          <view class="panel_middle">
            <view class="panel_remark">备注：{{item.remark!=null?item.remark:'无'}}</view>
          </view>
          <view class="panel_bottom">
            <view >下单时间：{{item.createdTime}}</view>
            <view class="panel_status {{item.statusName === '待确认' ? 'panel_status_dqr' : item.statusName === '待结算' ? 'panel_status_djs' : 'panel_status_yjs'}}">{{item.statusName}}</view>
          </view> 
      
        </view>
      </view>
    </van-tab>
  </van-tabs>
  <load-more id="loadMoreView" bindloadMoreListener='loadMoreListener' bindclickLoadMore='clickLoadMore'></load-more>
  <van-popup show="{{ showPopup }}" position="right" custom-style="height: 100%; width: 80%" bind:close="closePopup"> 
    <view class="popup_container">
      <view class="popup_title_reset">
        <view class="popup_title">更多筛选</view>
        <view class="popup_reset" bindtap="onReset"><van-icon name="replay" />重置</view>
      </view>
      <view class="date-picker_container">
        <!-- <van-cell custom-class="order-van_cell" title="" value="{{date[0]+'~'+date[1]}}" border="{{ false }}" is-link catchtap="opencalendar" /> -->
        <view class="date-picker_title">日期选择</view>
        <view class="date-picker_input" bindtap="opencalendar">{{selectDate[0]}}至{{selectDate[1]}}</view>
      </view>
   
    </view>
    <view class="popup_btn_group">
      <van-button bindtap="closePopup">取消</van-button>
      <van-button type="info" bindtap="onSubmit">确认</van-button>
    </view>
  </van-popup>
  <van-calendar color="#4696e7" show="{{ show }}" type="range" show-subtitle="{{false}}" min-date="{{ minDate }}" max-date="{{ maxDate }}" bind:close="onClose" bind:confirm="onConfirm" default-date="{{date}}" />
  <van-dialog id="van-dialog" />
</view>
