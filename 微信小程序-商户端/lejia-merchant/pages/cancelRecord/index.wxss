page {
  background: #f5f5f5;
}

.order-van_cell {
  font-size: 24rpx !important;
}

.top-atm_container {
  text-align: center;
  background-color: #4696e7;
  padding: 27rpx 0 36rpx 0;
  margin-bottom: 17rpx;
  display: flex;
  align-items: center;
}
.top-atm_container .top-atm_container_item {
  flex: 1;
}

.top-atm_container_item:first-child {
  border-right: 1px solid #fff;
}

.top-atm_container .tag {
  padding-bottom: 40rpx;
  font-size: 28rpx;
  color: #fff;
}
.top-atm_container .num {
  font-size: 72rpx;
	color: #ffffff;
}
.top-atm_container .num .unit {
  font-size: 32rpx;
}
.order-detial,
.order_item_container {
  padding-bottom: 40rpx;
}
/* .order-detial{
  background-color: #ffffff;

} */
.van-cell_title__line{
  width: 4rpx;
  height: 32rpx;
  display: inline-block;
  margin-right: 24rpx;
  background-color: #4696e7;
}
.van-cell_custom{
   display: inline-flex;
   align-items: center;
   display: flex;
   justify-content: space-between;
}
.order-detial_panel{
  overflow: hidden;
  padding:24rpx 20rpx 0rpx 15rpx;
  margin: 20rpx 20rpx 0 20rpx;
  /* border-bottom: 1rpx solid #d9d9d9; */
  border: 1px solid #d9d9d9;
  border-radius: 10rpx;
  background: #fff;
  box-shadow: 0px 1px 40rpx 0px rgba(0, 0, 0, 0.1);
}
.panel_top{
  padding-bottom: 21rpx;
}
.panel_middle ,.panel_bottom{
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  
}
.panel_bottom{
  margin-right:-20rpx;
  margin-bottom: 20rpx;
  color: #999999;
}
.panel_middle{
  padding-bottom: 24rpx;
}
.panel_middle view{
  width: 50%;
}
.panel_remark {
  flex: 1;
}
.panel_status {
  font-size: 42rpx;
  white-space: nowrap;
  margin-left: 12rpx;
}
.panel_status_dqr {
  color: #DE8850;
}
.panel_status_djs {
  color: #FF0000;
}
.panel_status_yjs {
  color: #00CC00;
}
.finish_purchase {
  width: 200rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(222, 136, 80, 1);
  font-size: 36rpx;
  color: #fff;
}
.popup_container {
  padding: 24rpx;
  font-size: 32rpx;
}
.popup_title_reset {
  margin-bottom: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.date-picker_container {
  margin-bottom: 60rpx;
}
.date-picker_input {
  /* font-size: 28rpx; */
  line-height: 2em;
  height: 2em;
  /* margin: 0 12rpx; */
  padding: 0 12rpx;
  background: #f2f4f7;
  border-radius: 10rpx;
  z-index: 10;
}
.date-picker_title,
.status_title {
  margin-bottom: 12rpx;
}
.popup_btn_group {
  position: fixed;
  bottom: 32rpx;
  right: 32rpx;
}