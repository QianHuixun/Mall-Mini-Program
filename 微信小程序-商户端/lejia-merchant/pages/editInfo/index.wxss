.mien_container {
  position: relative;
  top: -100rpx;
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx;
}
.mien_title {
  height: 78rpx;
  line-height: 78rex;
  font-weight: bold;
}
.mien_video,
.mien_image {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #949494;
}
.mien_image {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}
.mien_video .mien_video_title,
.mien_image .mien_video_title {
  font-size: 36rpx;
}
.mien_video .mien_video_suggest,
.mien_image .mien_video_suggest {
  font-size: 32rpx;
}
.mien_video .btn,
.mien_image .btn {
  width: 136rpx;
  height: 78rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border: none;
  outline: none;
}
.mien_video .btn::after,
.mien_image .btn::after {
  border: none
}
.mien_video .look_video {
  background: #f3fbff;
  color: #6cb3e3;
}
.mien_image .upload_img {
  background: #fffafa;
  color: #cc3333;
}
.videoCenter {
  /* display: none; */
}
.van-popup {
  background: transparent !important;
}
.show{
  display: block;
}
.hide {
  display: none;
}