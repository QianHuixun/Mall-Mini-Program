/* pages/editInfo/index.wxss */
page {
  background: #f5f5f5;
}
.top_container {
  position: relative;
  /* padding: 30rpx 30rpx 200rpx 30rpx; */
}
.my_bg {
  width: 100%;
}

.avatar_box {
  z-index: 1;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding-top: 48rpx;
  text-align: center;
}

.avatar_box .cell {
  padding: 0 20rpx;
}

.avatar_box .flex_cell {
  font-size: 40rpx;
  margin-top: 43rpx;
  color: #fff;
}

.editName {
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.editName text {
  margin-right: 6rpx;
}

.info_container {
  position: relative;
  top: -110rpx;
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.info_title {
  height: 78rpx;
  line-height: 78rex;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  font-weight: bold;
}
