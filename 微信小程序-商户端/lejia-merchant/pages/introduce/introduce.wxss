/* pages/introduce/introduce.wxss */
.introduce-page{
  position:absolute;
  top: 0px;
  left: 0px;
  width: 100%;
  bottom: 0px;
}

.introduce-page .bg-image{
  width: 100%;
  height: 100%;
}
.font-content{
  position: absolute;
  top: 115rpx;
  bottom: 0;
  left: 0;
  right:0;
  text-align: center;
  color:#fff;
}
.font-content .title{
  margin-bottom: 20rpx;
  font-size:40rpx;
  letter-spacing:6rpx;
  font-weight: 500;
  font-family:Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
}

.font-content .tips{
  font-size:32rpx;
  letter-spacing:2rpx;
  font-family:Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
}
