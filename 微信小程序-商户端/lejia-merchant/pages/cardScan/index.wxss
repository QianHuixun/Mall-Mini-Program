/* pages/cardScan/index.wxss */
page {
  background: #fff;
}

.xcx-header,
.xcx-main {
  background: #fff;
}

.xcx-header {
  padding-top: 104rpx;
  padding-bottom: 77rpx;
  /* border-bottom: 30rpx solid #f9f9f9; */
  text-align: center;
}
.xcx-line{
  width: 100%;
  height: 30rpx;
  background-color: #f9f9f9;
}
.xcx-header .txt {
  margin-top: 44rpx;
  font-size: 32rpx;
  color: #333;
}

.xcx-main {
  padding: 41rpx 39rpx;
}

.xcx-main .card_name {
  /* min-height: 290rpx; */
  /* margin: 0 39rpx; */
  box-sizing: border-box;
  padding: 24rpx;
  background: #f5f5f5;
  line-height: 48rpx;
  font-size: 32rpx;
  
}
.xcx-main .card_box{
  background: #f5f5f5;
  border-radius: 10rpx;
}
.xcx-main .btn-cell {
  margin-top: 142rpx;
}

.xcx-main .btn-cell .new-btn {
  margin-right: 24rpx;
  background: #35a3ff;
}

.xcx-main .btn-cell .new-btn,
.xcx-main .btn-cell .new-plain-btn {
  width: calc( ( 100% - 24rpx )/2);
  height: 90rpx;
  font-size: 34rpx;
  border-radius: 10rpx;
}

.xcx-main .btn-cell .new-plain-btn  {
  color: #35a3ff;
  border-color: #35a3ff;
}