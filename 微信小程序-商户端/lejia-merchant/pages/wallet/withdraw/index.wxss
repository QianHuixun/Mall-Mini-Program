/* pages/wallet/withdraw/index.wxss */
body,
#widthdraw {
  background: #F2F4F7;
  height: 100vh;
  overflow: hidden;
}

#widthdraw .van-cell__title {
  font-size: 30rpx;
  color: #333333;
}

#widthdraw .van-cell__value {
  font-weight: bold;
  font-size: 30rpx;
  color: #333333;
}

.withdraw-field {
  background: #fff;
  margin-top: 20rpx;
  padding-left: 24rpx;
}

.withdraw-field-title {
  font-size: 30rpx;
  color: #333333;
  padding-top: 34rpx;
  padding-bottom: 24rpx;
}

.withdraw-field-box {
  display: flex;
  border-bottom: 1px solid rgba(204, 204, 204, .5);
  padding-bottom: 32rpx;
}

.withdraw-field-box_icon {
  font-size: 48rpx;
  margin-right: 16rpx;
  line-height:90rpx;
}
.withdraw-field-box_field {
  flex: 1;
}

.withdraw-field-box_field .van-cell  {
  padding: 0;
  height: 90rpx;

}

.withdraw-field-box_field .van-cell .van-field__input {
  font-size: 64rpx;
  line-height: 90rpx;
  height: 90rpx;
}

.withdraw-field-box_all {
  font-size: 30rpx;
  color: #5B94E1;
  line-height: 90rpx;
  margin-right: 32rpx;
}
.withdraw-field-tips {
  height: 84rpx;
  line-height: 84rpx;
  font-size: 26rpx;
  color: #999999;
}

.withdraw-button {
  padding: 64rpx 24rpx 32rpx 24rpx;
}

.withdraw-button .van-button {
  width: 100%;
  height: 88rpx;
  background: #5B94E1;
  border-radius: 4rpx;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
}

.withdraw-tips {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
}

.custom-popup {
  width: 50%;
  text-align: center;
  padding: 50rpx 20rpx 50rpx 20rpx;
}

.custom-popup-title {
  font-size: 32rpx;
  margin-bottom: 15rpx;
  margin-top: 20rpx;
}

.custom-popup-tips {
  font-size: 28rpx;
  color:#999;
}
