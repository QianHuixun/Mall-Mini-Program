/* pages/order/finishOrder.wxss */
page{
  background-color: #F2F2F4;
  height: 100%;  
}

#finishOrder{
  height: 100%;  
}

.scroll-view {
  width: 100%;
  height: 100%;
}

.content{
  margin-top: 12rpx;
  background-color: white;
}

.top{
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #F5F6F7;
  font-size: 28rpx;
}

.item{
  padding: 16rpx;
  padding-left: 24rpx;
  display: flex;
  font-size: 24rpx;
}

.title{
  width: 20%;
  color: #999999;
}