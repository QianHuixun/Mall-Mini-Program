          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-无敏感信息" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def body = prev.getResponseDataAsString().toLowerCase()
[&apos;jdbc:&apos;, &apos;password&apos;, &apos;client_secret&apos;, &apos;private key&apos;, &apos;access_key&apos;].each { marker -&gt;
    if (body.contains(marker)) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;响应疑似泄露敏感信息: &apos; + marker)
    }
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Assertion>
